<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_bkm_dt" name="BKM with Decision Table"
  targetNamespace="https://example.com/dmn/bkm-dt">

  <businessKnowledgeModel id="BKM_discount" name="Discount Logic">
    <variable id="var_bkm_discount" name="discountResult" typeRef="number"/>
    <encapsulatedLogic id="EL_discount" kind="FEEL">
      <formalParameter id="FP_age" name="customerAge" typeRef="number"/>
      <formalParameter id="FP_status" name="memberStatus" typeRef="string"/>
      <decisionTable id="dt_bkm" hitPolicy="FIRST">
        <input id="Input_bkm_1" label="Customer Age">
          <inputExpression typeRef="number">customerAge</inputExpression>
        </input>
        <input id="Input_bkm_2" label="Member Status">
          <inputExpression typeRef="string">memberStatus</inputExpression>
        </input>
        <output id="Output_bkm_1" label="Discount" name="discount" typeRef="number"/>
        <rule id="Rule_bkm_1">
          <inputEntry id="IE_bkm_1"><text>&gt; 65</text></inputEntry>
          <inputEntry id="IE_bkm_2"><text>"gold"</text></inputEntry>
          <outputEntry id="OE_bkm_1"><text>20</text></outputEntry>
        </rule>
        <rule id="Rule_bkm_2">
          <inputEntry id="IE_bkm_3"><text>&gt; 65</text></inputEntry>
          <inputEntry id="IE_bkm_4"><text>-</text></inputEntry>
          <outputEntry id="OE_bkm_2"><text>15</text></outputEntry>
        </rule>
        <rule id="Rule_bkm_3">
          <inputEntry id="IE_bkm_5"><text>-</text></inputEntry>
          <inputEntry id="IE_bkm_6"><text>-</text></inputEntry>
          <outputEntry id="OE_bkm_3"><text>5</text></outputEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
  </businessKnowledgeModel>
</definitions>
