<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_chain_c" name="Chain Model C (leaf)"
  targetNamespace="https://example.com/dmn/chain-c">

  <inputData id="InputData_x" name="x" />

  <decision id="Decision_triple" name="Triple">
    <variable id="Var_triple" name="Triple" />
    <informationRequirement id="ir_triple_x">
      <requiredInput href="#InputData_x" />
    </informationRequirement>
    <literalExpression id="LE_triple">
      <text>x * 3</text>
    </literalExpression>
  </decision>
</definitions>
