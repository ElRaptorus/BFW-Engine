<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:evil="https://evilengine.dev/schema/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="https://evilengine.dev/schema/bpmn"
                  id="Definitions_EscalationCompensation">

  <bpmn:escalation id="Esc_1" name="Level2" escalationCode="ESC_LVL2" />

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process_EscComp" name="Escalation Compensation" processRef="Process_EscComp" />
  </bpmn:collaboration>

  <bpmn:process id="Process_EscComp" name="Escalation Compensation" isExecutable="true">
    <bpmn:extensionElements>
      <evil:version>1.0.0</evil:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalationHost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compensate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConditionalHost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Escalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Compensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Escalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Compensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Conditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompHandler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Compensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Boundary_Cond</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EscalationHost" name="Escalation Host">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Compensate" name="Compensate Target">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConditionalHost" name="Conditional Host">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Escalation" name="Escalation End">
      <bpmn:escalationEventDefinition escalationRef="Esc_1" />
      <bpmn:incoming>Flow_EscBoundary</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Compensation" name="Compensation End">
      <bpmn:compensateEventDefinition activityRef="Task_Compensate" />
      <bpmn:incoming>Flow_CompEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Cancel" name="Cancel End">
      <bpmn:cancelEventDefinition />
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:boundaryEvent id="Boundary_Escalation" name="Escalation Boundary" attachedToRef="Task_EscalationHost" cancelActivity="true">
      <bpmn:escalationEventDefinition escalationRef="Esc_1" />
      <bpmn:outgoing>Flow_EscBoundary</bpmn:outgoing>
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="Boundary_Compensation" name="Compensation Boundary" attachedToRef="Task_Compensate">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_CompHandler" name="Undo Compensate" isForCompensation="true" />

    <bpmn:association id="Association_Comp" sourceRef="Boundary_Compensation" targetRef="Task_CompHandler" associationDirection="One" />

    <bpmn:intermediateThrowEvent id="Throw_Compensation" name="Compensate Throw">
      <bpmn:compensateEventDefinition activityRef="Task_Compensate" />
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:boundaryEvent id="Boundary_Conditional" name="Conditional Boundary" attachedToRef="Task_ConditionalHost" cancelActivity="false">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">token.amount &gt; 1000</bpmn:condition>
      </bpmn:conditionalEventDefinition>
      <bpmn:outgoing>Flow_CondBoundary</bpmn:outgoing>
    </bpmn:boundaryEvent>


    <bpmn:endEvent id="End_Boundary_Cond" name="Cond Boundary End">
      <bpmn:incoming>Flow_CondBoundary</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_EscalationHost" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_EscalationHost" targetRef="Task_Compensate" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Compensate" targetRef="Throw_Compensation" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Throw_Compensation" targetRef="Task_ConditionalHost" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ConditionalHost" targetRef="End_Cancel" />
    <bpmn:sequenceFlow id="Flow_CompEnd" sourceRef="Task_Compensate" targetRef="End_Compensation" />
    <bpmn:sequenceFlow id="Flow_EscBoundary" sourceRef="Boundary_Escalation" targetRef="End_Escalation" />
    <bpmn:sequenceFlow id="Flow_CondBoundary" sourceRef="Boundary_Conditional" targetRef="End_Boundary_Cond" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_Process_EscComp" bpmnElement="Participant_Process_EscComp" isHorizontal="true">
        <dc:Bounds x="82" y="82" width="1146" height="396" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="82" width="1116" height="396" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EscalationHost" bpmnElement="Task_EscalationHost">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Compensate" bpmnElement="Task_Compensate">
        <dc:Bounds x="450" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Compensation" bpmnElement="Throw_Compensation">
        <dc:Bounds x="582" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ConditionalHost" bpmnElement="Task_ConditionalHost">
        <dc:Bounds x="690" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cancel" bpmnElement="End_Cancel">
        <dc:Bounds x="882" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CompHandler" bpmnElement="Task_CompHandler">
        <dc:Bounds x="450" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Escalation" bpmnElement="End_Escalation">
        <dc:Bounds x="482" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Compensation" bpmnElement="End_Compensation">
        <dc:Bounds x="642" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Escalation" bpmnElement="Boundary_Escalation">
        <dc:Bounds x="322" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Compensation" bpmnElement="Boundary_Compensation">
        <dc:Bounds x="482" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Conditional" bpmnElement="Boundary_Conditional">
        <dc:Bounds x="642" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Boundary_Cond" bpmnElement="End_Boundary_Cond">
        <dc:Bounds x="962" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="450" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="550" y="200" />
        <di:waypoint x="582" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="618" y="200" />
        <di:waypoint x="690" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="790" y="200" />
        <di:waypoint x="882" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CompEnd" bpmnElement="Flow_CompEnd">
        <di:waypoint x="500" y="240" />
        <di:waypoint x="500" y="300" />
        <di:waypoint x="642" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_EscBoundary" bpmnElement="Flow_EscBoundary">
        <di:waypoint x="340" y="258" />
        <di:waypoint x="411" y="258" />
        <di:waypoint x="411" y="300" />
        <di:waypoint x="482" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CondBoundary" bpmnElement="Flow_CondBoundary">
        <di:waypoint x="660" y="258" />
        <di:waypoint x="811" y="258" />
        <di:waypoint x="811" y="300" />
        <di:waypoint x="962" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
