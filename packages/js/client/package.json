{
  "name": "@elraptorus/bfw_engine_client",
  "version": "0.1.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElRaptorus/BFW-Engine.git",
    "directory": "packages/js/client"
  },
  "description": "TypeScript REST, GraphQL, and WebSocket client for the Bifrost Forge World Engine.",
  "main": "dist/index.js",
  "author": "Bifrost Forge World",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run test/unit/",
    "test:unit": "vitest run test/unit/",
    "test:integration": "vitest run test/integration/",
    "lint": "oxlint -c ../.oxlintrc.json --report-unused-disable-directives src test",
    "lint:fix": "oxlint -c ../.oxlintrc.json --fix --report-unused-disable-directives src test",
    "format": "oxfmt -c ../.oxfmtrc.json src test",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check src test"
  },
  "dependencies": {
    "@elraptorus/bfw_engine_sdk": "workspace:*",
    "phoenix": "^1.8.15"
  },
  "devDependencies": {
    "@types/phoenix": "^1.6.7",
    "jose": "^6.2.12",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
