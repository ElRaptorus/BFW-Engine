{
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm --filter @elraptorus/bfw_engine_client run test:integration",
    "test:examples": "pnpm --filter '@bfw-engine/example-*' run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
