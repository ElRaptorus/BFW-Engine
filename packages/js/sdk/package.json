{
  "name": "@elraptorus/daemonengine_sdk",
  "version": "0.1.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElRaptorus/ThomasTheDaemonEngine.git",
    "directory": "packages/js/sdk"
  },
  "description": "Everything you ever wanted to build yourself a blooddrenched altar for making sacrifies to the daemon engine. Choo Choo.",
  "main": "dist/index.js",
  "author": "Khorne",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.2",
      "onFail": "download"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit/",
    "test:conformance": "vitest run test/conformance/",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint --fix src/ test/",
    "format": "prettier --write --config ../.prettierrc.json src/ test/"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:"
  }
}
