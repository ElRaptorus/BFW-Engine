{
  "name": "@elraptorus/bfw_engine_sdk",
  "version": "0.2.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElRaptorus/BFW-Engine.git",
    "directory": "packages/js/sdk"
  },
  "description": "TypeScript contract layer for the Bifrost Forge World Engine: types, errors, events, and BPMN/DMN parsers.",
  "main": "dist/index.js",
  "author": "Bifrost Forge World",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit/",
    "test:conformance": "vitest run test/conformance/",
    "lint": "oxlint -c ../.oxlintrc.json --report-unused-disable-directives src test",
    "lint:fix": "oxlint -c ../.oxlintrc.json --fix --report-unused-disable-directives src test",
    "format": "oxfmt -c ../.oxfmtrc.json src test",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check src test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
