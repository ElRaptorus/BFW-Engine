<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_orchestrated-process" name="Orchestrated Process" processRef="orchestrated-process" />
  </bpmn:collaboration>
  <bpmn:process id="orchestrated-process" name="Orchestrated Process" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_orchestrated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_echo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_orchestrated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_orchestrated" name="Start">
      <bpmn:outgoing>Flow_start_echo</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_echo" name="Echo" implementation="echo">
      <bpmn:incoming>Flow_start_echo</bpmn:incoming>
      <bpmn:outgoing>Flow_echo_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_orchestrated" name="End">
      <bpmn:incoming>Flow_echo_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_echo" sourceRef="Start_orchestrated" targetRef="Task_echo" />
    <bpmn:sequenceFlow id="Flow_echo_end" sourceRef="Task_echo" targetRef="End_orchestrated" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_orchestrated-process" bpmnElement="Participant_orchestrated-process" isHorizontal="true">
        <dc:Bounds x="82" y="130" width="486" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="130" width="456" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_orchestrated" bpmnElement="Start_orchestrated">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_echo" bpmnElement="Task_echo">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_orchestrated" bpmnElement="End_orchestrated">
        <dc:Bounds x="482" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_start_echo" bpmnElement="Flow_start_echo">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_echo_end" bpmnElement="Flow_echo_end">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="482" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
