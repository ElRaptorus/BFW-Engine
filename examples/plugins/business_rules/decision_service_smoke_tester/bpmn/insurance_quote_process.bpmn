<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_insurance_quote">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_insurance-quote-process" name="Insurance Quote Process" processRef="insurance-quote-process" />
  </bpmn:collaboration>

  <bpmn:process id="insurance-quote-process" name="Insurance Quote Process" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_get_insurance_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_review_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Quote requested">
      <bpmn:outgoing>Flow_start_to_brt</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="BRT_get_insurance_quote" name="Get Insurance Quote" implementation="dmn">
      <bpmn:extensionElements>
        <bfw:decisionRef>insurance-pricing</bfw:decisionRef>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_brt</bpmn:incoming>
      <bpmn:outgoing>Flow_brt_to_review</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:userTask id="UserTask_review_quote" name="Review Quote">
      <bpmn:incoming>Flow_brt_to_review</bpmn:incoming>
      <bpmn:outgoing>Flow_review_to_end</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_1" name="Quote complete">
      <bpmn:incoming>Flow_review_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_to_brt" sourceRef="Start_1" targetRef="BRT_get_insurance_quote" />
    <bpmn:sequenceFlow id="Flow_brt_to_review" sourceRef="BRT_get_insurance_quote" targetRef="UserTask_review_quote" />
    <bpmn:sequenceFlow id="Flow_review_to_end" sourceRef="UserTask_review_quote" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_insurance-quote-process" bpmnElement="Participant_insurance-quote-process" isHorizontal="true">
        <dc:Bounds x="82" y="130" width="678" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="130" width="648" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BRT_get_insurance_quote" bpmnElement="BRT_get_insurance_quote">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_review_quote" bpmnElement="UserTask_review_quote">
        <dc:Bounds x="482" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="674" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_start_to_brt" bpmnElement="Flow_start_to_brt">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_brt_to_review" bpmnElement="Flow_brt_to_review">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="482" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_review_to_end" bpmnElement="Flow_review_to_end">
        <di:waypoint x="582" y="200" />
        <di:waypoint x="674" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
