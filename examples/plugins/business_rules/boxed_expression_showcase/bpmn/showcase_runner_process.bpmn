<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_showcase_runner">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_showcase-runner-process" name="Showcase Runner Process" processRef="showcase-runner-process" />
  </bpmn:collaboration>

  <bpmn:process id="showcase-runner-process" name="Showcase Runner Process" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_calculate_compensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Employee data received">
      <bpmn:outgoing>Flow_start_to_brt</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="BRT_calculate_compensation" name="Calculate Compensation" implementation="dmn">
      <bpmn:extensionElements>
        <bfw:decisionRef>expression-showcase</bfw:decisionRef>
        <bfw:decisionElementId>Decision_total_compensation</bfw:decisionElementId>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_brt</bpmn:incoming>
      <bpmn:outgoing>Flow_brt_to_end</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:endEvent id="End_1" name="Compensation calculated">
      <bpmn:incoming>Flow_brt_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_to_brt" sourceRef="Start_1" targetRef="BRT_calculate_compensation" />
    <bpmn:sequenceFlow id="Flow_brt_to_end" sourceRef="BRT_calculate_compensation" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_showcase-runner-process" bpmnElement="Participant_showcase-runner-process" isHorizontal="true">
        <dc:Bounds x="82" y="130" width="486" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="130" width="456" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BRT_calculate_compensation" bpmnElement="BRT_calculate_compensation">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="482" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_start_to_brt" bpmnElement="Flow_start_to_brt">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_brt_to_end" bpmnElement="Flow_brt_to_end">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="482" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
