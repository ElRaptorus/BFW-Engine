<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="shipping-rates" name="Shipping Rates"
  namespace="https://example.com/dmn/shipping">

  <inputData id="InputData_weight" name="weight">
    <variable name="weight" typeRef="number"/>
  </inputData>

  <inputData id="InputData_destination" name="destination">
    <variable name="destination" typeRef="string"/>
  </inputData>

  <inputData id="InputData_express" name="express">
    <variable name="express" typeRef="boolean"/>
  </inputData>

  <decision id="Decision_shipping_cost" name="Shipping Cost">
    <informationRequirement id="ir_weight">
      <requiredInput href="#InputData_weight"/>
    </informationRequirement>
    <informationRequirement id="ir_destination">
      <requiredInput href="#InputData_destination"/>
    </informationRequirement>
    <informationRequirement id="ir_express">
      <requiredInput href="#InputData_express"/>
    </informationRequirement>
    <decisionTable id="dt_shipping_cost" hitPolicy="FIRST">
      <input id="Input_express" label="Express">
        <inputExpression typeRef="boolean">express</inputExpression>
      </input>
      <input id="Input_destination" label="Destination">
        <inputExpression typeRef="string">destination</inputExpression>
      </input>
      <input id="Input_weight" label="Weight (kg)">
        <inputExpression typeRef="number">weight</inputExpression>
      </input>
      <output id="Output_base_cost" label="Base Cost" name="baseCost" typeRef="number"/>
      <output id="Output_delivery_days" label="Delivery Days" name="deliveryDays" typeRef="number"/>
      <rule id="Rule_express_domestic_light">
        <inputEntry id="IE_express_1"><text>true</text></inputEntry>
        <inputEntry id="IE_destination_1"><text>"domestic"</text></inputEntry>
        <inputEntry id="IE_weight_1"><text>&lt; 5</text></inputEntry>
        <outputEntry id="OE_base_1"><text>12.99</text></outputEntry>
        <outputEntry id="OE_days_1"><text>1</text></outputEntry>
      </rule>
      <rule id="Rule_express_domestic_heavy">
        <inputEntry id="IE_express_2"><text>true</text></inputEntry>
        <inputEntry id="IE_destination_2"><text>"domestic"</text></inputEntry>
        <inputEntry id="IE_weight_2"><text>&gt;= 5</text></inputEntry>
        <outputEntry id="OE_base_2"><text>19.99</text></outputEntry>
        <outputEntry id="OE_days_2"><text>1</text></outputEntry>
      </rule>
      <rule id="Rule_express_international">
        <inputEntry id="IE_express_3"><text>true</text></inputEntry>
        <inputEntry id="IE_destination_3"><text>"international"</text></inputEntry>
        <inputEntry id="IE_weight_3"><text>-</text></inputEntry>
        <outputEntry id="OE_base_3"><text>49.99</text></outputEntry>
        <outputEntry id="OE_days_3"><text>3</text></outputEntry>
      </rule>
      <rule id="Rule_economy_domestic_light">
        <inputEntry id="IE_express_4"><text>false</text></inputEntry>
        <inputEntry id="IE_destination_4"><text>"domestic"</text></inputEntry>
        <inputEntry id="IE_weight_4"><text>&lt; 2</text></inputEntry>
        <outputEntry id="OE_base_4"><text>4.99</text></outputEntry>
        <outputEntry id="OE_days_4"><text>5</text></outputEntry>
      </rule>
      <rule id="Rule_economy_domestic_medium">
        <inputEntry id="IE_express_5"><text>false</text></inputEntry>
        <inputEntry id="IE_destination_5"><text>"domestic"</text></inputEntry>
        <inputEntry id="IE_weight_5"><text>&lt; 10</text></inputEntry>
        <outputEntry id="OE_base_5"><text>8.99</text></outputEntry>
        <outputEntry id="OE_days_5"><text>5</text></outputEntry>
      </rule>
      <rule id="Rule_economy_domestic_heavy">
        <inputEntry id="IE_express_6"><text>false</text></inputEntry>
        <inputEntry id="IE_destination_6"><text>"domestic"</text></inputEntry>
        <inputEntry id="IE_weight_6"><text>&gt;= 10</text></inputEntry>
        <outputEntry id="OE_base_6"><text>14.99</text></outputEntry>
        <outputEntry id="OE_days_6"><text>7</text></outputEntry>
      </rule>
      <rule id="Rule_economy_international_light">
        <inputEntry id="IE_express_7"><text>false</text></inputEntry>
        <inputEntry id="IE_destination_7"><text>"international"</text></inputEntry>
        <inputEntry id="IE_weight_7"><text>&lt; 5</text></inputEntry>
        <outputEntry id="OE_base_7"><text>24.99</text></outputEntry>
        <outputEntry id="OE_days_7"><text>14</text></outputEntry>
      </rule>
      <rule id="Rule_economy_international_heavy">
        <inputEntry id="IE_express_8"><text>false</text></inputEntry>
        <inputEntry id="IE_destination_8"><text>"international"</text></inputEntry>
        <inputEntry id="IE_weight_8"><text>&gt;= 5</text></inputEntry>
        <outputEntry id="OE_base_8"><text>39.99</text></outputEntry>
        <outputEntry id="OE_days_8"><text>14</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
