#!/bin/sh
# Per-release env overrides (applied before the release boots).
# See: https://hexdocs.pm/mix/Mix.Tasks.Release.html#module-runtime-configuration

# Listen on all interfaces inside the container so healthchecks and
# reverse proxies can reach the engine.
export ERL_AFLAGS="-proto_dist inet_tcp"

# Use the long name only if a cluster is ever configured (Phase 6).
# Single-node deployments use the default short name.
export RELEASE_DISTRIBUTION="name"
export RELEASE_NODE="${RELEASE_NODE:-bfw_engine@127.0.0.1}"
