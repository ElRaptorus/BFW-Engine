<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_ResumeEventSubprocessChild">

  <bpmn:message id="Msg_Escalate" name="resume-esp-escalate" />

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="ResumeEventSubprocessChild" />
  </bpmn:collaboration>

  <bpmn:process id="ResumeEventSubprocessChild" name="Resume Event Subprocess Child" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_UserTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP_Escalate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Main_UserTask" name="Main Work">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Main_UserTask" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Main_UserTask" targetRef="End_1" />

    <bpmn:subProcess id="ESP_Escalate" name="Escalation Handling" triggeredByEvent="true">
      <bpmn:startEvent id="ESP_Start" name="Escalation Requested" isInterrupting="false">
        <bpmn:outgoing>ESP_Flow_1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ESP_MsgDef" messageRef="Msg_Escalate" />
      </bpmn:startEvent>

      <bpmn:userTask id="ESP_UserTask" name="Handle Escalation">
        <bpmn:incoming>ESP_Flow_1</bpmn:incoming>
        <bpmn:outgoing>ESP_Flow_2</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:endEvent id="ESP_End" name="Escalation Handled">
        <bpmn:incoming>ESP_Flow_2</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="ESP_Flow_1" sourceRef="ESP_Start" targetRef="ESP_UserTask" />
      <bpmn:sequenceFlow id="ESP_Flow_2" sourceRef="ESP_UserTask" targetRef="ESP_End" />
    </bpmn:subProcess>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="560" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="530" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="182" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Main_UserTask" bpmnElement="Main_UserTask">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="472" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Escalate" bpmnElement="ESP_Escalate" isExpanded="true">
        <dc:Bounds x="200" y="290" width="400" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Start" bpmnElement="ESP_Start">
        <dc:Bounds x="232" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_UserTask" bpmnElement="ESP_UserTask">
        <dc:Bounds x="330" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_End" bpmnElement="ESP_End">
        <dc:Bounds x="512" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="218" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="472" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_1" bpmnElement="ESP_Flow_1">
        <di:waypoint x="268" y="370" />
        <di:waypoint x="330" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_2" bpmnElement="ESP_Flow_2">
        <di:waypoint x="430" y="370" />
        <di:waypoint x="512" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
