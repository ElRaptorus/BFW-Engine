                  id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_InclusiveGatewayFatalOnBranch" name="Inclusive Gateway Fatal On Branch" processRef="InclusiveGatewayFatalOnBranch" />
  </bpmn:collaboration>
  <bpmn:process id="InclusiveGatewayFatalOnBranch" name="Inclusive Gateway Fatal On Branch" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IncSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_Bad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IncJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="IncSplit" name="Split">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="UserTask_A" name="User Task A">
      <bpmn:extensionElements>
        <bfw:formFields>{"fields":[]}</bfw:formFields>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_Bad" name="Bad Service Task" implementation="nonexistent_handler">
      <bpmn:incoming>Flow_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="IncJoin" name="Join">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Join</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="IncSplit" />
    <bpmn:sequenceFlow id="Flow_A" sourceRef="IncSplit" targetRef="UserTask_A">
      <bpmn:conditionExpression>token.a = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="IncSplit" targetRef="ServiceTask_Bad">
      <bpmn:conditionExpression>token.b = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="UserTask_A" targetRef="IncJoin" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="ServiceTask_Bad" targetRef="IncJoin" />
    <bpmn:sequenceFlow id="Flow_Join" sourceRef="IncJoin" targetRef="End_1" />
  </bpmn:process>
