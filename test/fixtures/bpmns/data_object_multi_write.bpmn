<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_DataObjectMultiWrite" name="Data Object Multi Write" processRef="DataObjectMultiWrite" />
  </bpmn:collaboration>
  <bpmn:process id="DataObjectMultiWrite" name="Data Object Multi Write" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DO_1" name="Counter"/>
    <bpmn:dataObjectReference id="DOR_1" dataObjectRef="DO_1"/>
    <bpmn:startEvent id="Start_1" name="Start"/>
    <bpmn:scriptTask id="ScriptTask_1" name="First Write" scriptFormat="feel">
      <bpmn:script>{"step": 1, "value": token.amount}</bpmn:script>
      <bpmn:dataOutputAssociation id="DOA_1">
        <bpmn:targetRef>DOR_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="ScriptTask_2" name="Second Write" scriptFormat="feel">
      <bpmn:script>{"step": 2, "value": token.value * 10}</bpmn:script>
      <bpmn:dataOutputAssociation id="DOA_2">
        <bpmn:targetRef>DOR_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_1" name="End"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="ScriptTask_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ScriptTask_1" targetRef="ScriptTask_2"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ScriptTask_2" targetRef="End_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_DataObjectMultiWrite" bpmnElement="Participant_DataObjectMultiWrite" isHorizontal="true">
        <dc:Bounds x="82" y="130" width="646" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="130" width="616" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ScriptTask_1" bpmnElement="ScriptTask_1">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ScriptTask_2" bpmnElement="ScriptTask_2">
        <dc:Bounds x="450" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="642" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DOR_1" bpmnElement="DOR_1">
        <dc:Bounds x="162" y="300" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="450" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="550" y="200" />
        <di:waypoint x="642" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
