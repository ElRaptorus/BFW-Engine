<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_InclusiveGatewayJoinInLoop">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="InclusiveGatewayJoinInLoop" />
  </bpmn:collaboration>

  <bpmn:process id="InclusiveGatewayJoinInLoop" name="Inclusive Gateway Join In Loop" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Script_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Script_Increment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Script_Init" name="Reset Counter" scriptFormat="feel">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script>{ counter: 0 }</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Loop Entry">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_Again</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="Gateway_Fork" name="Fork">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_A_In</bpmn:outgoing>
      <bpmn:outgoing>Flow_B_In</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="Task_A" name="Branch A">
      <bpmn:incoming>Flow_A_In</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Out</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_B" name="Branch B">
      <bpmn:incoming>Flow_B_In</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Out</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="Gateway_Join" name="Join">
      <bpmn:incoming>Flow_A_Out</bpmn:incoming>
      <bpmn:incoming>Flow_B_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:scriptTask id="Script_Increment" name="Count Pass" scriptFormat="feel">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:script>{ counter: token.counter + 1 }</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Loop" name="Another Pass?" default="Flow_Exit">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Again</bpmn:outgoing>
      <bpmn:outgoing>Flow_Exit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Exit</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Script_Init" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Script_Init" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Merge" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_A_In" sourceRef="Gateway_Fork" targetRef="Task_A">
      <bpmn:conditionExpression>true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B_In" sourceRef="Gateway_Fork" targetRef="Task_B">
      <bpmn:conditionExpression>true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A_Out" sourceRef="Task_A" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_B_Out" sourceRef="Task_B" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Join" targetRef="Script_Increment" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Script_Increment" targetRef="Gateway_Loop" />
    <bpmn:sequenceFlow id="Flow_Again" sourceRef="Gateway_Loop" targetRef="Gateway_Merge">
      <bpmn:conditionExpression>token.counter &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Exit" sourceRef="Gateway_Loop" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="1060" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="130" y="40" width="1030" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Script_Init" bpmnElement="Script_Init">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Merge" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="385" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Fork" bpmnElement="Gateway_Fork">
        <dc:Bounds x="475" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A" bpmnElement="Task_A">
        <dc:Bounds x="570" y="70" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_B" bpmnElement="Task_B">
        <dc:Bounds x="570" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Join" bpmnElement="Gateway_Join">
        <dc:Bounds x="715" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Script_Increment" bpmnElement="Script_Increment">
        <dc:Bounds x="810" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Loop" bpmnElement="Gateway_Loop" isMarkerVisible="true">
        <dc:Bounds x="955" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="1062" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="385" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="435" y="200" />
        <di:waypoint x="475" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A_In" bpmnElement="Flow_A_In">
        <di:waypoint x="500" y="175" />
        <di:waypoint x="500" y="110" />
        <di:waypoint x="570" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B_In" bpmnElement="Flow_B_In">
        <di:waypoint x="500" y="225" />
        <di:waypoint x="500" y="290" />
        <di:waypoint x="570" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A_Out" bpmnElement="Flow_A_Out">
        <di:waypoint x="670" y="110" />
        <di:waypoint x="740" y="110" />
        <di:waypoint x="740" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B_Out" bpmnElement="Flow_B_Out">
        <di:waypoint x="670" y="290" />
        <di:waypoint x="740" y="290" />
        <di:waypoint x="740" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="765" y="200" />
        <di:waypoint x="810" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="910" y="200" />
        <di:waypoint x="955" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Again" bpmnElement="Flow_Again">
        <di:waypoint x="980" y="225" />
        <di:waypoint x="980" y="380" />
        <di:waypoint x="410" y="380" />
        <di:waypoint x="410" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Exit" bpmnElement="Flow_Exit">
        <di:waypoint x="1005" y="200" />
        <di:waypoint x="1062" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
