  </bpmn:collaboration>
  <bpmn:process id="CallActivityResumeParent" name="Call Activity Resume Parent" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>2.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
