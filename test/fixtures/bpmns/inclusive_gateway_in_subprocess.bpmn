      <bpmndi:BPMNShape id="Shape_Task_B" bpmnElement="Task_B">
        <dc:Bounds x="450" y="252" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_IncJoin" bpmnElement="IncJoin">
