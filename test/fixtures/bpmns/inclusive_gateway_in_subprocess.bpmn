<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  targetNamespace="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_InclusiveGatewayInSubprocess" name="Inclusive Gateway In Subprocess" processRef="InclusiveGatewayInSubprocess" />
  </bpmn:collaboration>
  <bpmn:process id="InclusiveGatewayInSubprocess" name="Inclusive Gateway In Subprocess" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_1" name="Sub Process">
      <bpmn:startEvent id="SubStart_1" name="Sub Start">
        <bpmn:outgoing>Sub_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:inclusiveGateway id="IncSplit" name="Split">
        <bpmn:incoming>Sub_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_A</bpmn:outgoing>
        <bpmn:outgoing>Sub_Flow_B</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:task id="Task_A" name="Task A">
        <bpmn:incoming>Sub_Flow_A</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_A2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_B" name="Task B">
        <bpmn:incoming>Sub_Flow_B</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_B2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:inclusiveGateway id="IncJoin" name="Join">
        <bpmn:incoming>Sub_Flow_A2</bpmn:incoming>
        <bpmn:incoming>Sub_Flow_B2</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_Join</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:endEvent id="SubEnd_1" name="Sub End">
        <bpmn:incoming>Sub_Flow_Join</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_Flow_1" sourceRef="SubStart_1" targetRef="IncSplit" />
      <bpmn:sequenceFlow id="Sub_Flow_A" sourceRef="IncSplit" targetRef="Task_A">
        <bpmn:conditionExpression>token.a = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sub_Flow_B" sourceRef="IncSplit" targetRef="Task_B">
        <bpmn:conditionExpression>token.b = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sub_Flow_A2" sourceRef="Task_A" targetRef="IncJoin" />
      <bpmn:sequenceFlow id="Sub_Flow_B2" sourceRef="Task_B" targetRef="IncJoin" />
      <bpmn:sequenceFlow id="Sub_Flow_Join" sourceRef="IncJoin" targetRef="SubEnd_1" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="SubProcess_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_1" targetRef="End_1" />
  </bpmn:process>
