<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_1">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="EventSubprocessError" />
  </bpmn:collaboration>

  <bpmn:error id="Error_1" name="ProcessError" errorCode="ERR_SUBPROCESS" />

  <bpmn:process id="EventSubprocessError" name="Event Subprocess Error" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EmbSub_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP_Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Main_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="EmbSub_1" name="Failing Subprocess">
      <bpmn:incoming>Main_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Main_Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="EmbSub_Start" name="Sub Start">
        <bpmn:outgoing>EmbSub_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="EmbSub_Task" name="Do Work">
        <bpmn:incoming>EmbSub_Flow_1</bpmn:incoming>
        <bpmn:outgoing>EmbSub_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="EmbSub_ErrorEnd" name="Raise Error">
        <bpmn:errorEventDefinition id="EmbSub_ErrorDef" errorRef="Error_1" />
        <bpmn:incoming>EmbSub_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="EmbSub_Flow_1" sourceRef="EmbSub_Start" targetRef="EmbSub_Task" />
      <bpmn:sequenceFlow id="EmbSub_Flow_2" sourceRef="EmbSub_Task" targetRef="EmbSub_ErrorEnd" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Main_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Main_Flow_1" sourceRef="Start_1" targetRef="EmbSub_1" />
    <bpmn:sequenceFlow id="Main_Flow_2" sourceRef="EmbSub_1" targetRef="End_1" />

    <bpmn:subProcess id="ESP_Error" name="Error Event Subprocess" triggeredByEvent="true">
      <bpmn:startEvent id="ESP_Start" name="Error Caught" isInterrupting="true">
        <bpmn:errorEventDefinition id="ESP_ErrorDef" errorRef="Error_1" />
        <bpmn:outgoing>ESP_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="ESP_Task" name="Handle Error">
        <bpmn:incoming>ESP_Flow_1</bpmn:incoming>
        <bpmn:outgoing>ESP_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP_End" name="ESP Done">
        <bpmn:incoming>ESP_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ESP_Flow_1" sourceRef="ESP_Start" targetRef="ESP_Task" />
      <bpmn:sequenceFlow id="ESP_Flow_2" sourceRef="ESP_Task" targetRef="ESP_End" />
    </bpmn:subProcess>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="60" width="760" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="60" width="730" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_1" bpmnElement="EmbSub_1" isExpanded="true">
        <dc:Bounds x="280" y="90" width="380" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_Start" bpmnElement="EmbSub_Start">
        <dc:Bounds x="300" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_Task" bpmnElement="EmbSub_Task">
        <dc:Bounds x="390" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_ErrorEnd" bpmnElement="EmbSub_ErrorEnd">
        <dc:Bounds x="552" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="722" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Error" bpmnElement="ESP_Error" isExpanded="true">
        <dc:Bounds x="200" y="290" width="380" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Start" bpmnElement="ESP_Start">
        <dc:Bounds x="220" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Task" bpmnElement="ESP_Task">
        <dc:Bounds x="310" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_End" bpmnElement="ESP_End">
        <dc:Bounds x="462" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Main_Flow_1" bpmnElement="Main_Flow_1">
        <di:waypoint x="198" y="160" />
        <di:waypoint x="280" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Main_Flow_2" bpmnElement="Main_Flow_2">
        <di:waypoint x="660" y="160" />
        <di:waypoint x="722" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_EmbSub_Flow_1" bpmnElement="EmbSub_Flow_1">
        <di:waypoint x="336" y="160" />
        <di:waypoint x="390" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_EmbSub_Flow_2" bpmnElement="EmbSub_Flow_2">
        <di:waypoint x="490" y="160" />
        <di:waypoint x="552" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_1" bpmnElement="ESP_Flow_1">
        <di:waypoint x="256" y="370" />
        <di:waypoint x="310" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_2" bpmnElement="ESP_Flow_2">
        <di:waypoint x="410" y="370" />
        <di:waypoint x="462" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
