<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  targetNamespace="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1">
  <bpmn:escalation id="Escalation_1" name="process_error" escalationCode="PROCESS_ERROR" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="CompensationEscalationThenCompensate" />
  </bpmn:collaboration>
  <bpmn:process id="CompensationEscalationThenCompensate" name="Compensation Escalation Then Compensate" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Comp_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompHandler_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Escalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Compensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Compensated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Normal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_A" name="Task A">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="BE_Comp_A" attachedToRef="Task_A" cancelActivity="false">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_CompHandler_A" name="Compensation Handler A" isForCompensation="true" />
    <bpmn:subProcess id="SubProcess_1" name="Escalating Sub Process">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Normal</bpmn:outgoing>
      <bpmn:startEvent id="SP_Start" name="SP Start">
        <bpmn:outgoing>Sub_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_Inner" name="Inner Task">
        <bpmn:incoming>Sub_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Escalation_End" name="Escalation End">
        <bpmn:incoming>Sub_Flow_2</bpmn:incoming>
        <bpmn:escalationEventDefinition escalationRef="Escalation_1" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sub_Flow_1" sourceRef="SP_Start" targetRef="Task_Inner" />
      <bpmn:sequenceFlow id="Sub_Flow_2" sourceRef="Task_Inner" targetRef="Escalation_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BE_Escalation" attachedToRef="SubProcess_1" cancelActivity="true">
      <bpmn:outgoing>Flow_BE</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Escalation_1" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Throw_Compensation" name="Throw Compensation">
      <bpmn:incoming>Flow_BE</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Compensated" name="Compensated End">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Normal" name="Normal End">
      <bpmn:incoming>Flow_Normal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:association id="Association_Comp" sourceRef="BE_Comp_A" targetRef="Task_CompHandler_A" associationDirection="One" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_A" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_A" targetRef="SubProcess_1" />
    <bpmn:sequenceFlow id="Flow_Normal" sourceRef="SubProcess_1" targetRef="End_Normal" />
    <bpmn:sequenceFlow id="Flow_BE" sourceRef="BE_Escalation" targetRef="Throw_Compensation" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Throw_Compensation" targetRef="End_Compensated" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="60" width="1060" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="60" width="1030" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A" bpmnElement="Task_A">
        <dc:Bounds x="260" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_Comp_A" bpmnElement="BE_Comp_A">
        <dc:Bounds x="292" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CompHandler_A" bpmnElement="Task_CompHandler_A">
        <dc:Bounds x="260" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_1" bpmnElement="SubProcess_1" isExpanded="true">
        <dc:Bounds x="430" y="110" width="340" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SP_Start" bpmnElement="SP_Start">
        <dc:Bounds x="460" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Inner" bpmnElement="Task_Inner">
        <dc:Bounds x="550" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Escalation_End" bpmnElement="Escalation_End">
        <dc:Bounds x="700" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_Escalation" bpmnElement="BE_Escalation">
        <dc:Bounds x="582" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Compensation" bpmnElement="Throw_Compensation">
        <dc:Bounds x="862" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Compensated" bpmnElement="End_Compensated">
        <dc:Bounds x="982" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Normal" bpmnElement="End_Normal">
        <dc:Bounds x="862" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="200" />
        <di:waypoint x="430" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Sub_Flow_1" bpmnElement="Sub_Flow_1">
        <di:waypoint x="496" y="200" />
        <di:waypoint x="550" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Sub_Flow_2" bpmnElement="Sub_Flow_2">
        <di:waypoint x="650" y="200" />
        <di:waypoint x="700" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Normal" bpmnElement="Flow_Normal">
        <di:waypoint x="770" y="200" />
        <di:waypoint x="816" y="200" />
        <di:waypoint x="816" y="110" />
        <di:waypoint x="862" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_BE" bpmnElement="Flow_BE">
        <di:waypoint x="600" y="328" />
        <di:waypoint x="600" y="380" />
        <di:waypoint x="820" y="380" />
        <di:waypoint x="820" y="200" />
        <di:waypoint x="862" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="898" y="200" />
        <di:waypoint x="982" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
