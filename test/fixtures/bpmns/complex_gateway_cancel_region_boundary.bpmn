<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_ComplexGatewayCancelRegionBoundary">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="ComplexGatewayCancelRegionBoundary" />
  </bpmn:collaboration>

  <bpmn:process id="ComplexGatewayCancelRegionBoundary" name="Complex Gateway Cancel Region Boundary" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ComplexSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ComplexJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Timeout</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:complexGateway id="ComplexSplit" name="Split">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:complexGateway>
    <bpmn:task id="Task_A" name="Task A">
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Out</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="UserTask_B" name="User Task B">
      <bpmn:incoming>Flow_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Out</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_B" name="One Hour" attachedToRef="UserTask_B">
      <bpmn:outgoing>Flow_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:complexGateway id="ComplexJoin" name="Join">
      <bpmn:incoming>Flow_A_Out</bpmn:incoming>
      <bpmn:incoming>Flow_B_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
      <bpmn:activationCondition>activatedCount &gt;= 1</bpmn:activationCondition>
    </bpmn:complexGateway>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Join</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Timeout" name="Timed Out">
      <bpmn:incoming>Flow_Timeout</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="ComplexSplit" />
    <bpmn:sequenceFlow id="Flow_A" sourceRef="ComplexSplit" targetRef="Task_A">
      <bpmn:conditionExpression>true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="ComplexSplit" targetRef="UserTask_B">
      <bpmn:conditionExpression>true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A_Out" sourceRef="Task_A" targetRef="ComplexJoin" />
    <bpmn:sequenceFlow id="Flow_B_Out" sourceRef="UserTask_B" targetRef="ComplexJoin" />
    <bpmn:sequenceFlow id="Flow_Join" sourceRef="ComplexJoin" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_Timeout" sourceRef="Timer_B" targetRef="End_Timeout" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="800" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="130" y="40" width="770" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ComplexSplit" bpmnElement="ComplexSplit">
        <dc:Bounds x="255" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A" bpmnElement="Task_A">
        <dc:Bounds x="370" y="70" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_B" bpmnElement="UserTask_B">
        <dc:Bounds x="370" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Timer_B" bpmnElement="Timer_B">
        <dc:Bounds x="402" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ComplexJoin" bpmnElement="ComplexJoin">
        <dc:Bounds x="555" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="702" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Timeout" bpmnElement="End_Timeout">
        <dc:Bounds x="562" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="255" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A" bpmnElement="Flow_A">
        <di:waypoint x="280" y="175" />
        <di:waypoint x="280" y="110" />
        <di:waypoint x="370" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B" bpmnElement="Flow_B">
        <di:waypoint x="280" y="225" />
        <di:waypoint x="280" y="290" />
        <di:waypoint x="370" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A_Out" bpmnElement="Flow_A_Out">
        <di:waypoint x="470" y="110" />
        <di:waypoint x="580" y="110" />
        <di:waypoint x="580" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B_Out" bpmnElement="Flow_B_Out">
        <di:waypoint x="470" y="290" />
        <di:waypoint x="580" y="290" />
        <di:waypoint x="580" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Join" bpmnElement="Flow_Join">
        <di:waypoint x="605" y="200" />
        <di:waypoint x="702" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Timeout" bpmnElement="Flow_Timeout">
        <di:waypoint x="420" y="348" />
        <di:waypoint x="420" y="410" />
        <di:waypoint x="562" y="410" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
