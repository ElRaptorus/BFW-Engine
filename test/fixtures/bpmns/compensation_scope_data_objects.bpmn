<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_CompensationScopeDataObjects"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">

  <!--
    The handler of Task_Book runs in the subprocess's own instance: it reads
    and writes the subprocess's DO_Status, never the parent's DO_Status, and
    takes the subprocess's lane.
  -->

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="CompensationScopeDataObjects" />
  </bpmn:collaboration>

  <bpmn:process id="CompensationScopeDataObjects" name="Compensation Scope Data Objects" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_booking" name="booking">
        <bpmn:flowNodeRef>SubProcess_Booking</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataObject id="DO_Status" name="Status" />
    <bpmn:dataObjectReference id="DOR_Status_Parent" dataObjectRef="DO_Status" />

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:scriptTask id="Task_Prepare" name="Prepare" scriptFormat="feel">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Prepare">
        <bpmn:targetRef>DOR_Status_Parent</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>{ phase: "outer" }</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:subProcess id="SubProcess_Booking" name="Booking">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>

      <bpmn:dataObject id="DO_Status" name="Status" />
      <bpmn:dataObjectReference id="DOR_Status_Inner" dataObjectRef="DO_Status" />

      <bpmn:startEvent id="Sub_Start" name="Sub Start">
        <bpmn:outgoing>Sub_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:scriptTask id="Task_Book" name="Book" scriptFormat="feel">
        <bpmn:incoming>Sub_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_2</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DOA_Book">
          <bpmn:targetRef>DOR_Status_Inner</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:script>{ phase: "booked" }</bpmn:script>
      </bpmn:scriptTask>

      <bpmn:boundaryEvent id="BE_Comp_Book" name="Compensate Book" attachedToRef="Task_Book" cancelActivity="false">
        <bpmn:compensateEventDefinition />
      </bpmn:boundaryEvent>

      <bpmn:scriptTask id="Task_Undo_Book" name="Undo Book" scriptFormat="feel" isForCompensation="true">
        <bpmn:dataOutputAssociation id="DOA_Undo_Book">
          <bpmn:targetRef>DOR_Status_Inner</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:script>{ phase: "undone", seen: dataObjects.DO_Status.phase }</bpmn:script>
      </bpmn:scriptTask>

      <bpmn:endEvent id="Sub_End" name="Sub End">
        <bpmn:incoming>Sub_Flow_2</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Sub_Flow_1" sourceRef="Sub_Start" targetRef="Task_Book" />
      <bpmn:sequenceFlow id="Sub_Flow_2" sourceRef="Task_Book" targetRef="Sub_End" />

      <bpmn:association id="Assoc_Comp_Book" sourceRef="BE_Comp_Book" targetRef="Task_Undo_Book" associationDirection="One" />
    </bpmn:subProcess>

    <bpmn:intermediateThrowEvent id="Throw_Comp" name="Compensate">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Prepare" targetRef="SubProcess_Booking" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SubProcess_Booking" targetRef="Throw_Comp" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Throw_Comp" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="130" width="806" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="130" width="776" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_booking" bpmnElement="Lane_booking" isHorizontal="true">
        <dc:Bounds x="112" y="255" width="776" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Prepare" bpmnElement="Task_Prepare">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_Booking" bpmnElement="SubProcess_Booking">
        <dc:Bounds x="450" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Comp" bpmnElement="Throw_Comp">
        <dc:Bounds x="642" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="802" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DOR_Status_Parent" bpmnElement="DOR_Status_Parent">
        <dc:Bounds x="162" y="300" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="450" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="550" y="200" />
        <di:waypoint x="642" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="678" y="200" />
        <di:waypoint x="802" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
