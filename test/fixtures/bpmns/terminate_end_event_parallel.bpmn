<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_TerminateParallel" name="Terminate Parallel" processRef="TerminateParallel" />
  </bpmn:collaboration>
  <bpmn:process id="TerminateParallel" name="Terminate Parallel" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Fork_1" name="Fork">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_A" name="Quick Path">
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Terminate" name="Terminate">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateDef_1" />
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_Wait" name="Waiting User Task">
      <bpmn:incoming>Flow_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Normal" name="Normal End">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Fork_1" />
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Fork_1" targetRef="Task_A" />
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Fork_1" targetRef="UserTask_Wait" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_A" targetRef="End_Terminate" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="UserTask_Wait" targetRef="End_Normal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_TerminateParallel" isHorizontal="true">
        <dc:Bounds x="82" y="82" width="656" height="336" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork_1" bpmnElement="Fork_1">
        <dc:Bounds x="262" y="225" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A" bpmnElement="Task_A">
        <dc:Bounds x="382" y="132" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Terminate" bpmnElement="End_Terminate">
        <dc:Bounds x="562" y="154" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_Wait" bpmnElement="UserTask_Wait">
        <dc:Bounds x="382" y="282" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Normal" bpmnElement="End_Normal">
        <dc:Bounds x="562" y="304" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="250" />
        <di:waypoint x="262" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A" bpmnElement="Flow_A">
        <di:waypoint x="287" y="225" />
        <di:waypoint x="287" y="172" />
        <di:waypoint x="382" y="172" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B" bpmnElement="Flow_B">
        <di:waypoint x="287" y="275" />
        <di:waypoint x="287" y="322" />
        <di:waypoint x="382" y="322" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A2" bpmnElement="Flow_A2">
        <di:waypoint x="482" y="172" />
        <di:waypoint x="562" y="172" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B2" bpmnElement="Flow_B2">
        <di:waypoint x="482" y="322" />
        <di:waypoint x="562" y="322" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
