<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_CompensationSubprocessPropagation">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="CompensationSubprocessPropagation" />
  </bpmn:collaboration>

  <bpmn:process id="CompensationSubprocessPropagation" name="Compensation Subprocess Propagation" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:subProcess id="SubProcess_Booking" name="Booking">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>

      <bpmn:startEvent id="Sub_Start" name="Sub Start">
        <bpmn:outgoing>Sub_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:task id="Task_Hotel" name="Book Hotel">
        <bpmn:incoming>Sub_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_2</bpmn:outgoing>
      </bpmn:task>

      <bpmn:boundaryEvent id="BE_Comp_Hotel" name="Compensate Hotel" attachedToRef="Task_Hotel" cancelActivity="false">
        <bpmn:compensateEventDefinition />
      </bpmn:boundaryEvent>

      <bpmn:userTask id="UT_Undo_Hotel" name="Cancel Hotel" isForCompensation="true" />

      <bpmn:task id="Task_Flight" name="Book Flight">
        <bpmn:incoming>Sub_Flow_2</bpmn:incoming>
        <bpmn:outgoing>Sub_Flow_3</bpmn:outgoing>
      </bpmn:task>

      <bpmn:boundaryEvent id="BE_Comp_Flight" name="Compensate Flight" attachedToRef="Task_Flight" cancelActivity="false">
        <bpmn:compensateEventDefinition />
      </bpmn:boundaryEvent>

      <bpmn:userTask id="UT_Undo_Flight" name="Cancel Flight" isForCompensation="true" />

      <bpmn:endEvent id="Sub_End" name="Sub End">
        <bpmn:incoming>Sub_Flow_3</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Sub_Flow_1" sourceRef="Sub_Start" targetRef="Task_Hotel" />
      <bpmn:sequenceFlow id="Sub_Flow_2" sourceRef="Task_Hotel" targetRef="Task_Flight" />
      <bpmn:sequenceFlow id="Sub_Flow_3" sourceRef="Task_Flight" targetRef="Sub_End" />

      <bpmn:association id="Assoc_Comp_Hotel" sourceRef="BE_Comp_Hotel" targetRef="UT_Undo_Hotel" associationDirection="One" />
      <bpmn:association id="Assoc_Comp_Flight" sourceRef="BE_Comp_Flight" targetRef="UT_Undo_Flight" associationDirection="One" />
    </bpmn:subProcess>

    <bpmn:intermediateThrowEvent id="Throw_Comp" name="Compensate">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="SubProcess_Booking" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_Booking" targetRef="Throw_Comp" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Throw_Comp" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="60" width="900" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="870" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_Booking" bpmnElement="SubProcess_Booking" isExpanded="true">
        <dc:Bounds x="260" y="100" width="480" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sub_Start" bpmnElement="Sub_Start">
        <dc:Bounds x="282" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Hotel" bpmnElement="Task_Hotel">
        <dc:Bounds x="370" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_Comp_Hotel" bpmnElement="BE_Comp_Hotel">
        <dc:Bounds x="402" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UT_Undo_Hotel" bpmnElement="UT_Undo_Hotel">
        <dc:Bounds x="370" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Flight" bpmnElement="Task_Flight">
        <dc:Bounds x="530" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_Comp_Flight" bpmnElement="BE_Comp_Flight">
        <dc:Bounds x="562" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UT_Undo_Flight" bpmnElement="UT_Undo_Flight">
        <dc:Bounds x="530" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sub_End" bpmnElement="Sub_End">
        <dc:Bounds x="682" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Comp" bpmnElement="Throw_Comp">
        <dc:Bounds x="822" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="942" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Sub_Flow_1" bpmnElement="Sub_Flow_1">
        <di:waypoint x="318" y="200" />
        <di:waypoint x="370" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Sub_Flow_2" bpmnElement="Sub_Flow_2">
        <di:waypoint x="470" y="200" />
        <di:waypoint x="530" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Sub_Flow_3" bpmnElement="Sub_Flow_3">
        <di:waypoint x="630" y="200" />
        <di:waypoint x="682" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Comp_Hotel" bpmnElement="Assoc_Comp_Hotel">
        <di:waypoint x="420" y="258" />
        <di:waypoint x="420" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Comp_Flight" bpmnElement="Assoc_Comp_Flight">
        <di:waypoint x="580" y="258" />
        <di:waypoint x="580" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="740" y="200" />
        <di:waypoint x="822" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="858" y="200" />
        <di:waypoint x="942" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
