<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_CompensationCompletionOrder">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="CompensationCompletionOrder" />
  </bpmn:collaboration>

  <bpmn:process id="CompensationCompletionOrder" name="Compensation Completion Order" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Comp_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Undo_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Comp_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Undo_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="Fork" name="Fork">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_Prep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="UT_A" name="A">
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A_Join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BE_Comp_A" name="Compensate A" attachedToRef="UT_A" cancelActivity="false">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_Undo_A" name="Undo A" isForCompensation="true" />

    <bpmn:task id="Task_Prep" name="Prepare B">
      <bpmn:incoming>Flow_Prep</bpmn:incoming>
      <bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="UT_B" name="B">
      <bpmn:incoming>Flow_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B_Join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BE_Comp_B" name="Compensate B" attachedToRef="UT_B" cancelActivity="false">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_Undo_B" name="Undo B" isForCompensation="true" />

    <bpmn:parallelGateway id="Join" name="Join">
      <bpmn:incoming>Flow_A_Join</bpmn:incoming>
      <bpmn:incoming>Flow_B_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="UT_Wait" name="Wait">
      <bpmn:incoming>Flow_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Throw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateThrowEvent id="Throw_Comp" name="Compensate">
      <bpmn:incoming>Flow_Throw</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Fork" />
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Fork" targetRef="UT_A" />
    <bpmn:sequenceFlow id="Flow_Prep" sourceRef="Fork" targetRef="Task_Prep" />
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Task_Prep" targetRef="UT_B" />
    <bpmn:sequenceFlow id="Flow_A_Join" sourceRef="UT_A" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_B_Join" sourceRef="UT_B" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Wait" sourceRef="Join" targetRef="UT_Wait" />
    <bpmn:sequenceFlow id="Flow_Throw" sourceRef="UT_Wait" targetRef="Throw_Comp" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Throw_Comp" targetRef="End_1" />

    <bpmn:association id="Assoc_Comp_A" sourceRef="BE_Comp_A" targetRef="Task_Undo_A" associationDirection="One" />
    <bpmn:association id="Assoc_Comp_B" sourceRef="BE_Comp_B" targetRef="Task_Undo_B" associationDirection="One" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1090" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1060" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork" bpmnElement="Fork">
        <dc:Bounds x="275" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UT_A" bpmnElement="UT_A">
        <dc:Bounds x="410" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_Comp_A" bpmnElement="BE_Comp_A">
        <dc:Bounds x="442" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Undo_A" bpmnElement="Task_Undo_A">
        <dc:Bounds x="410" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Prep" bpmnElement="Task_Prep">
        <dc:Bounds x="370" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UT_B" bpmnElement="UT_B">
        <dc:Bounds x="530" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_Comp_B" bpmnElement="BE_Comp_B">
        <dc:Bounds x="562" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Undo_B" bpmnElement="Task_Undo_B">
        <dc:Bounds x="530" y="490" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Join" bpmnElement="Join">
        <dc:Bounds x="715" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UT_Wait" bpmnElement="UT_Wait">
        <dc:Bounds x="830" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Comp" bpmnElement="Throw_Comp">
        <dc:Bounds x="1002" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="1122" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="280" />
        <di:waypoint x="275" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A" bpmnElement="Flow_A">
        <di:waypoint x="300" y="255" />
        <di:waypoint x="300" y="160" />
        <di:waypoint x="410" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Prep" bpmnElement="Flow_Prep">
        <di:waypoint x="300" y="305" />
        <di:waypoint x="300" y="400" />
        <di:waypoint x="370" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B" bpmnElement="Flow_B">
        <di:waypoint x="470" y="400" />
        <di:waypoint x="530" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A_Join" bpmnElement="Flow_A_Join">
        <di:waypoint x="510" y="160" />
        <di:waypoint x="740" y="160" />
        <di:waypoint x="740" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B_Join" bpmnElement="Flow_B_Join">
        <di:waypoint x="630" y="400" />
        <di:waypoint x="740" y="400" />
        <di:waypoint x="740" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Wait" bpmnElement="Flow_Wait">
        <di:waypoint x="765" y="280" />
        <di:waypoint x="830" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Throw" bpmnElement="Flow_Throw">
        <di:waypoint x="930" y="280" />
        <di:waypoint x="1002" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_End" bpmnElement="Flow_End">
        <di:waypoint x="1038" y="280" />
        <di:waypoint x="1122" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Comp_A" bpmnElement="Assoc_Comp_A">
        <di:waypoint x="460" y="218" />
        <di:waypoint x="460" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Comp_B" bpmnElement="Assoc_Comp_B">
        <di:waypoint x="580" y="458" />
        <di:waypoint x="580" y="490" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
