<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  targetNamespace="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_deep">

  <bpmn:collaboration id="Collaboration_deep">
    <bpmn:participant id="Participant_deep" name="Transaction Retry Nested Deep" processRef="transaction_retry_nested_deep" />
  </bpmn:collaboration>

  <!-- Used by TX-RETRY-NESTED-DEEP test.
       Chain: Transaction → Embedded SubProcess → Call Activity → tx_retry_deep_grandchild (fatals)
       All of the following must be rejected with retry_inside_transaction_scope:
         - Retry of the grandchild CA PI
         - Retry of the SP child PI
       Only retrying from the transaction shell or further upstream succeeds. -->
  <bpmn:process id="transaction_retry_nested_deep" name="Transaction Retry Nested Deep" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tx_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:transaction id="Tx_1" name="Outer Transaction">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>

      <bpmn:laneSet id="LaneSet_Tx">
        <bpmn:lane id="Lane_Tx" name="default">
          <bpmn:flowNodeRef>Tx_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_SP</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>

      <bpmn:startEvent id="Tx_Start" name="TX Start">
        <bpmn:outgoing>TxFlow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <!-- Embedded subprocess that contains the Call Activity -->
      <bpmn:subProcess id="Tx_SP" name="Middle Subprocess">
        <bpmn:incoming>TxFlow_1</bpmn:incoming>
        <bpmn:outgoing>TxFlow_2</bpmn:outgoing>

        <bpmn:laneSet id="LaneSet_SP">
          <bpmn:lane id="Lane_SP" name="default">
            <bpmn:flowNodeRef>Sp_Start</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Sp_CA</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>Sp_End</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:laneSet>

        <bpmn:startEvent id="Sp_Start" name="SP Start">
          <bpmn:outgoing>SpFlow_1</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- Call Activity calling the grandchild process that fatals -->
        <bpmn:callActivity id="Sp_CA" name="Grandchild" calledElement="tx_retry_deep_grandchild">
          <bpmn:incoming>SpFlow_1</bpmn:incoming>
          <bpmn:outgoing>SpFlow_2</bpmn:outgoing>
        </bpmn:callActivity>

        <bpmn:endEvent id="Sp_End" name="SP End">
          <bpmn:incoming>SpFlow_2</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="SpFlow_1" sourceRef="Sp_Start" targetRef="Sp_CA" />
        <bpmn:sequenceFlow id="SpFlow_2" sourceRef="Sp_CA" targetRef="Sp_End" />
      </bpmn:subProcess>

      <bpmn:endEvent id="Tx_End" name="TX End">
        <bpmn:incoming>TxFlow_2</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="TxFlow_1" sourceRef="Tx_Start" targetRef="Tx_SP" />
      <bpmn:sequenceFlow id="TxFlow_2" sourceRef="Tx_SP" targetRef="Tx_End" />
    </bpmn:transaction>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Tx_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Tx_1" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_deep">
    <bpmndi:BPMNPlane id="BPMNPlane_deep" bpmnElement="Collaboration_deep">
      <bpmndi:BPMNShape id="Shape_Participant_deep" bpmnElement="Participant_deep" isHorizontal="true">
        <dc:Bounds x="102" y="30" width="966" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_1" bpmnElement="Tx_1" isExpanded="true">
        <dc:Bounds x="260" y="60" width="640" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_Start" bpmnElement="Tx_Start">
        <dc:Bounds x="292" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_SP" bpmnElement="Tx_SP" isExpanded="true">
        <dc:Bounds x="390" y="100" width="380" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sp_Start" bpmnElement="Sp_Start">
        <dc:Bounds x="412" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sp_CA" bpmnElement="Sp_CA">
        <dc:Bounds x="510" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sp_End" bpmnElement="Sp_End">
        <dc:Bounds x="672" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_End" bpmnElement="Tx_End">
        <dc:Bounds x="820" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="1002" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TxFlow_1" bpmnElement="TxFlow_1">
        <di:waypoint x="328" y="200" />
        <di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SpFlow_1" bpmnElement="SpFlow_1">
        <di:waypoint x="448" y="200" />
        <di:waypoint x="510" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SpFlow_2" bpmnElement="SpFlow_2">
        <di:waypoint x="610" y="200" />
        <di:waypoint x="672" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TxFlow_2" bpmnElement="TxFlow_2">
        <di:waypoint x="770" y="200" />
        <di:waypoint x="820" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="900" y="200" />
        <di:waypoint x="1002" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
