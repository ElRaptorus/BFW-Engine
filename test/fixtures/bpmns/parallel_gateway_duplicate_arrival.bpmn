<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_ParallelGatewayDuplicateArrival">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="ParallelGatewayDuplicateArrival" />
  </bpmn:collaboration>

  <bpmn:process id="ParallelGatewayDuplicateArrival" name="Parallel Gateway Duplicate Arrival" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Fork" name="Fork">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Task_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_1" name="Task 1">
      <bpmn:incoming>Flow_Task_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_1_Out</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Task 2">
      <bpmn:incoming>Flow_Task_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_2_Out</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="UserTask_Wait" name="Wait">
      <bpmn:incoming>Flow_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Out</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Merge">
      <bpmn:incoming>Flow_Task_1_Out</bpmn:incoming>
      <bpmn:incoming>Flow_Task_2_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_Merged</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Join" name="Join">
      <bpmn:incoming>Flow_Merged</bpmn:incoming>
      <bpmn:incoming>Flow_Wait_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Task_1" sourceRef="Gateway_Fork" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_Task_2" sourceRef="Gateway_Fork" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_Wait" sourceRef="Gateway_Fork" targetRef="UserTask_Wait" />
    <bpmn:sequenceFlow id="Flow_Task_1_Out" sourceRef="Task_1" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_Task_2_Out" sourceRef="Task_2" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_Merged" sourceRef="Gateway_Merge" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Wait_Out" sourceRef="UserTask_Wait" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_Join" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="860" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="130" y="40" width="830" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Fork" bpmnElement="Gateway_Fork">
        <dc:Bounds x="255" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_1" bpmnElement="Task_1">
        <dc:Bounds x="370" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_2" bpmnElement="Task_2">
        <dc:Bounds x="370" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_Wait" bpmnElement="UserTask_Wait">
        <dc:Bounds x="370" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Merge" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="535" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Join" bpmnElement="Gateway_Join">
        <dc:Bounds x="685" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="822" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="255" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_1" bpmnElement="Flow_Task_1">
        <di:waypoint x="280" y="175" />
        <di:waypoint x="280" y="100" />
        <di:waypoint x="370" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_2" bpmnElement="Flow_Task_2">
        <di:waypoint x="305" y="200" />
        <di:waypoint x="370" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Wait" bpmnElement="Flow_Wait">
        <di:waypoint x="280" y="225" />
        <di:waypoint x="280" y="340" />
        <di:waypoint x="370" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_1_Out" bpmnElement="Flow_Task_1_Out">
        <di:waypoint x="470" y="100" />
        <di:waypoint x="560" y="100" />
        <di:waypoint x="560" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Task_2_Out" bpmnElement="Flow_Task_2_Out">
        <di:waypoint x="470" y="200" />
        <di:waypoint x="560" y="200" />
        <di:waypoint x="560" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Merged" bpmnElement="Flow_Merged">
        <di:waypoint x="585" y="150" />
        <di:waypoint x="710" y="150" />
        <di:waypoint x="710" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Wait_Out" bpmnElement="Flow_Wait_Out">
        <di:waypoint x="470" y="340" />
        <di:waypoint x="710" y="340" />
        <di:waypoint x="710" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="735" y="200" />
        <di:waypoint x="822" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
