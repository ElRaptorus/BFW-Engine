<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_UserTaskDueDateInvalid"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_UserTaskDueDateInvalid" name="User Task Due Date Invalid" processRef="UserTaskDueDateInvalid" />
  </bpmn:collaboration>
  <bpmn:process id="UserTaskDueDateInvalid" name="User Task Due Date Invalid" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_BadDueDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_NullDueDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DurationDueDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_MisspelledDueDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start"/>
    <bpmn:exclusiveGateway id="Gateway_Case" name="Which due date?" default="Flow_Bad"/>
    <bpmn:userTask id="UserTask_BadDueDate" name="Bad Due Date">
      <bpmn:extensionElements>
        <bfw:dueDate>"next week"</bfw:dueDate>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_NullDueDate" name="Null Due Date">
      <bpmn:extensionElements>
        <bfw:dueDate>null</bfw:dueDate>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_DurationDueDate" name="Duration Due Date">
      <bpmn:extensionElements>
        <bfw:dueDate>duration("PT1H")</bfw:dueDate>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_MisspelledDueDate" name="Misspelled Due Date">
      <bpmn:extensionElements>
        <bfw:dueDate>token.dedline</bfw:dueDate>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="End"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gateway_Case"/>
    <bpmn:sequenceFlow id="Flow_Bad" sourceRef="Gateway_Case" targetRef="UserTask_BadDueDate"/>
    <bpmn:sequenceFlow id="Flow_Null" sourceRef="Gateway_Case" targetRef="UserTask_NullDueDate">
      <bpmn:conditionExpression>token.case = "null"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Duration" sourceRef="Gateway_Case" targetRef="UserTask_DurationDueDate">
      <bpmn:conditionExpression>token.case = "duration"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Misspelled" sourceRef="Gateway_Case" targetRef="UserTask_MisspelledDueDate">
      <bpmn:conditionExpression>token.case = "misspelled"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Bad_End" sourceRef="UserTask_BadDueDate" targetRef="End_1"/>
    <bpmn:sequenceFlow id="Flow_Null_End" sourceRef="UserTask_NullDueDate" targetRef="End_1"/>
    <bpmn:sequenceFlow id="Flow_Duration_End" sourceRef="UserTask_DurationDueDate" targetRef="End_1"/>
    <bpmn:sequenceFlow id="Flow_Misspelled_End" sourceRef="UserTask_MisspelledDueDate" targetRef="End_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_UserTaskDueDateInvalid" bpmnElement="Participant_UserTaskDueDateInvalid" isHorizontal="true">
        <dc:Bounds x="82" y="40" width="632" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="40" width="602" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Case" bpmnElement="Gateway_Case" isMarkerVisible="true">
        <dc:Bounds x="255" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_BadDueDate" bpmnElement="UserTask_BadDueDate">
        <dc:Bounds x="380" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_NullDueDate" bpmnElement="UserTask_NullDueDate">
        <dc:Bounds x="380" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_DurationDueDate" bpmnElement="UserTask_DurationDueDate">
        <dc:Bounds x="380" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_MisspelledDueDate" bpmnElement="UserTask_MisspelledDueDate">
        <dc:Bounds x="380" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="582" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="100" />
        <di:waypoint x="255" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Bad" bpmnElement="Flow_Bad">
        <di:waypoint x="305" y="100" />
        <di:waypoint x="380" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Null" bpmnElement="Flow_Null">
        <di:waypoint x="280" y="125" />
        <di:waypoint x="280" y="200" />
        <di:waypoint x="380" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Duration" bpmnElement="Flow_Duration">
        <di:waypoint x="280" y="125" />
        <di:waypoint x="280" y="300" />
        <di:waypoint x="380" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Misspelled" bpmnElement="Flow_Misspelled">
        <di:waypoint x="280" y="125" />
        <di:waypoint x="280" y="400" />
        <di:waypoint x="380" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Bad_End" bpmnElement="Flow_Bad_End">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="582" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Null_End" bpmnElement="Flow_Null_End">
        <di:waypoint x="480" y="200" />
        <di:waypoint x="600" y="200" />
        <di:waypoint x="600" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Duration_End" bpmnElement="Flow_Duration_End">
        <di:waypoint x="480" y="300" />
        <di:waypoint x="600" y="300" />
        <di:waypoint x="600" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Misspelled_End" bpmnElement="Flow_Misspelled_End">
        <di:waypoint x="480" y="400" />
        <di:waypoint x="600" y="400" />
        <di:waypoint x="600" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
