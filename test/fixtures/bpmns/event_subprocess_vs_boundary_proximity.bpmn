<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_1">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="EventSubprocessVsBoundaryProximity" />
  </bpmn:collaboration>

  <bpmn:escalation id="Esc_Proximity" name="proximity-escalation" escalationCode="ESC_PROX" />

  <bpmn:process id="EventSubprocessVsBoundaryProximity" name="Event Subprocess Vs Boundary Proximity" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EmbSub_Escalating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Escalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BoundaryPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BoundaryCaught</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP_Escalation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Main_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="EmbSub_Escalating" name="Escalating Subprocess">
      <bpmn:incoming>Main_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Main_Flow_2</bpmn:outgoing>
      <bpmn:startEvent id="EmbSub_Start" name="Sub Start">
        <bpmn:outgoing>EmbSub_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="EmbSub_Throw" name="Throw Escalation">
        <bpmn:escalationEventDefinition id="EmbSub_EscDef" escalationRef="Esc_Proximity" />
        <bpmn:incoming>EmbSub_Flow_1</bpmn:incoming>
        <bpmn:outgoing>EmbSub_Flow_2</bpmn:outgoing>
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="EmbSub_End" name="Sub End">
        <bpmn:incoming>EmbSub_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="EmbSub_Flow_1" sourceRef="EmbSub_Start" targetRef="EmbSub_Throw" />
      <bpmn:sequenceFlow id="EmbSub_Flow_2" sourceRef="EmbSub_Throw" targetRef="EmbSub_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Escalation" name="Catch Escalation" attachedToRef="EmbSub_Escalating" cancelActivity="false">
      <bpmn:escalationEventDefinition id="Boundary_EscDef" escalationRef="Esc_Proximity" />
      <bpmn:outgoing>Boundary_Flow_1</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Normal" name="Normal End">
      <bpmn:incoming>Main_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_BoundaryPath" name="Boundary Caught">
      <bpmn:incoming>Boundary_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Boundary_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_BoundaryCaught" name="Boundary End">
      <bpmn:incoming>Boundary_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Main_Flow_1" sourceRef="Start_1" targetRef="EmbSub_Escalating" />
    <bpmn:sequenceFlow id="Main_Flow_2" sourceRef="EmbSub_Escalating" targetRef="End_Normal" />
    <bpmn:sequenceFlow id="Boundary_Flow_1" sourceRef="Boundary_Escalation" targetRef="Task_BoundaryPath" />
    <bpmn:sequenceFlow id="Boundary_Flow_2" sourceRef="Task_BoundaryPath" targetRef="End_BoundaryCaught" />

    <bpmn:subProcess id="ESP_Escalation" name="Escalation Event Subprocess" triggeredByEvent="true">
      <bpmn:startEvent id="ESP_Start" name="ESP Escalation Caught" isInterrupting="false">
        <bpmn:escalationEventDefinition id="ESP_EscDef" escalationRef="Esc_Proximity" />
        <bpmn:outgoing>ESP_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="ESP_Task" name="ESP Handle Escalation">
        <bpmn:incoming>ESP_Flow_1</bpmn:incoming>
        <bpmn:outgoing>ESP_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP_End" name="ESP Done">
        <bpmn:incoming>ESP_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ESP_Flow_1" sourceRef="ESP_Start" targetRef="ESP_Task" />
      <bpmn:sequenceFlow id="ESP_Flow_2" sourceRef="ESP_Task" targetRef="ESP_End" />
    </bpmn:subProcess>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="40" width="780" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="40" width="750" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_Escalating" bpmnElement="EmbSub_Escalating" isExpanded="true">
        <dc:Bounds x="280" y="80" width="340" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_Start" bpmnElement="EmbSub_Start">
        <dc:Bounds x="300" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_Throw" bpmnElement="EmbSub_Throw">
        <dc:Bounds x="400" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EmbSub_End" bpmnElement="EmbSub_End">
        <dc:Bounds x="510" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Escalation" bpmnElement="Boundary_Escalation">
        <dc:Bounds x="432" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Normal" bpmnElement="End_Normal">
        <dc:Bounds x="692" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_BoundaryPath" bpmnElement="Task_BoundaryPath">
        <dc:Bounds x="530" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BoundaryCaught" bpmnElement="End_BoundaryCaught">
        <dc:Bounds x="692" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Escalation" bpmnElement="ESP_Escalation" isExpanded="true">
        <dc:Bounds x="200" y="370" width="380" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Start" bpmnElement="ESP_Start">
        <dc:Bounds x="220" y="417" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Task" bpmnElement="ESP_Task">
        <dc:Bounds x="310" y="395" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_End" bpmnElement="ESP_End">
        <dc:Bounds x="462" y="417" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Main_Flow_1" bpmnElement="Main_Flow_1">
        <di:waypoint x="198" y="150" />
        <di:waypoint x="280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Main_Flow_2" bpmnElement="Main_Flow_2">
        <di:waypoint x="620" y="150" />
        <di:waypoint x="692" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_EmbSub_Flow_1" bpmnElement="EmbSub_Flow_1">
        <di:waypoint x="336" y="150" />
        <di:waypoint x="400" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_EmbSub_Flow_2" bpmnElement="EmbSub_Flow_2">
        <di:waypoint x="436" y="150" />
        <di:waypoint x="510" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Boundary_Flow_1" bpmnElement="Boundary_Flow_1">
        <di:waypoint x="450" y="238" />
        <di:waypoint x="450" y="290" />
        <di:waypoint x="530" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Boundary_Flow_2" bpmnElement="Boundary_Flow_2">
        <di:waypoint x="630" y="290" />
        <di:waypoint x="692" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_1" bpmnElement="ESP_Flow_1">
        <di:waypoint x="256" y="435" />
        <di:waypoint x="310" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_2" bpmnElement="ESP_Flow_2">
        <di:waypoint x="410" y="435" />
        <di:waypoint x="462" y="435" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
