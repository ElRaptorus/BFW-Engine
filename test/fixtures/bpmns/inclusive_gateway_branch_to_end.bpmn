<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  targetNamespace="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_InclusiveGatewayBranchToEnd" name="Inclusive Gateway Branch To End" processRef="InclusiveGatewayBranchToEnd" />
  </bpmn:collaboration>
  <bpmn:process id="InclusiveGatewayBranchToEnd" name="Inclusive Gateway Branch To End" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="InclusiveSplit" name="Inclusive Split">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="Task_A" name="Task A">
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A_to_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_B" name="Task B">
      <bpmn:incoming>Flow_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B_to_Xor</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveSplit" name="Route Split" default="Flow_B_to_Join">
      <bpmn:incoming>Flow_B_to_Xor</bpmn:incoming>
      <bpmn:outgoing>Flow_B_to_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_B_to_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_B" name="Branch End">
      <bpmn:incoming>Flow_B_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:inclusiveGateway id="InclusiveJoin" name="Inclusive Join">
      <bpmn:incoming>Flow_A_to_Join</bpmn:incoming>
      <bpmn:incoming>Flow_B_to_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Join</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="InclusiveSplit" />
    <bpmn:sequenceFlow id="Flow_A" sourceRef="InclusiveSplit" targetRef="Task_A">
      <bpmn:conditionExpression>token.x = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B" sourceRef="InclusiveSplit" targetRef="Task_B">
      <bpmn:conditionExpression>token.x = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A_to_Join" sourceRef="Task_A" targetRef="InclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_B_to_Xor" sourceRef="Task_B" targetRef="ExclusiveSplit" />
    <bpmn:sequenceFlow id="Flow_B_to_End" sourceRef="ExclusiveSplit" targetRef="End_B">
      <bpmn:conditionExpression>token.route = "end"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B_to_Join" sourceRef="ExclusiveSplit" targetRef="InclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_Join" sourceRef="InclusiveJoin" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_InclusiveGatewayBranchToEnd" bpmnElement="Participant_InclusiveGatewayBranchToEnd" isHorizontal="true">
        <dc:Bounds x="82" y="52" width="1116" height="336" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="52" width="1086" height="336" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InclusiveSplit" bpmnElement="InclusiveSplit">
        <dc:Bounds x="315" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A" bpmnElement="Task_A">
        <dc:Bounds x="470" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_B" bpmnElement="Task_B">
        <dc:Bounds x="470" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ExclusiveSplit" bpmnElement="ExclusiveSplit">
        <dc:Bounds x="635" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_B" bpmnElement="End_B">
        <dc:Bounds x="802" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InclusiveJoin" bpmnElement="InclusiveJoin">
        <dc:Bounds x="795" y="60" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="962" y="67" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="315" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A" bpmnElement="Flow_A">
        <di:waypoint x="340" y="175" />
        <di:waypoint x="340" y="100" />
        <di:waypoint x="470" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B" bpmnElement="Flow_B">
        <di:waypoint x="340" y="225" />
        <di:waypoint x="340" y="300" />
        <di:waypoint x="470" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A_to_Join" bpmnElement="Flow_A_to_Join">
        <di:waypoint x="570" y="100" />
        <di:waypoint x="795" y="100" />
        <di:waypoint x="820" y="85" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B_to_Xor" bpmnElement="Flow_B_to_Xor">
        <di:waypoint x="570" y="300" />
        <di:waypoint x="635" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B_to_End" bpmnElement="Flow_B_to_End">
        <di:waypoint x="685" y="300" />
        <di:waypoint x="802" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B_to_Join" bpmnElement="Flow_B_to_Join">
        <di:waypoint x="660" y="275" />
        <di:waypoint x="660" y="85" />
        <di:waypoint x="795" y="85" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Join" bpmnElement="Flow_Join">
        <di:waypoint x="845" y="85" />
        <di:waypoint x="962" y="85" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
