<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  targetNamespace="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ParallelGatewayPayloadMerge" name="Parallel Gateway Payload Merge" processRef="ParallelGatewayPayloadMerge" />
  </bpmn:collaboration>
  <bpmn:process id="ParallelGatewayPayloadMerge" name="Parallel Gateway Payload Merge" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Fork_1" name="Fork">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_B</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:scriptTask id="ScriptTask_A" name="Add key_a" scriptFormat="feel">
      <bpmn:script>{"key_a": "value_a"}</bpmn:script>
      <bpmn:incoming>Flow_A</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="ScriptTask_B" name="Add key_b" scriptFormat="feel">
      <bpmn:script>{"key_b": "value_b"}</bpmn:script>
      <bpmn:incoming>Flow_B</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="Join_1" name="Join">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_Join</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Join</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Fork_1" />
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Fork_1" targetRef="ScriptTask_A" />
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Fork_1" targetRef="ScriptTask_B" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="ScriptTask_A" targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="ScriptTask_B" targetRef="Join_1" />
    <bpmn:sequenceFlow id="Flow_Join" sourceRef="Join_1" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_ParallelGatewayPayloadMerge" bpmnElement="Participant_ParallelGatewayPayloadMerge" isHorizontal="true">
        <dc:Bounds x="82" y="52" width="796" height="336" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="52" width="766" height="336" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork_1" bpmnElement="Fork_1">
        <dc:Bounds x="315" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ScriptTask_A" bpmnElement="ScriptTask_A">
        <dc:Bounds x="470" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ScriptTask_B" bpmnElement="ScriptTask_B">
        <dc:Bounds x="470" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Join_1" bpmnElement="Join_1">
        <dc:Bounds x="635" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="802" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="315" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A" bpmnElement="Flow_A">
        <di:waypoint x="340" y="175" />
        <di:waypoint x="340" y="100" />
        <di:waypoint x="470" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B" bpmnElement="Flow_B">
        <di:waypoint x="340" y="225" />
        <di:waypoint x="340" y="300" />
        <di:waypoint x="470" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_A2" bpmnElement="Flow_A2">
        <di:waypoint x="570" y="100" />
        <di:waypoint x="660" y="100" />
        <di:waypoint x="660" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_B2" bpmnElement="Flow_B2">
        <di:waypoint x="570" y="300" />
        <di:waypoint x="660" y="300" />
        <di:waypoint x="660" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Join" bpmnElement="Flow_Join">
        <di:waypoint x="685" y="200" />
        <di:waypoint x="802" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
