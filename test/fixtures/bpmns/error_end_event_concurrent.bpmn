<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  targetNamespace="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_EEE_Concurrent">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Error End Concurrent" processRef="ErrorEndConcurrent" />
  </bpmn:collaboration>
  <bpmn:process id="ErrorEndConcurrent" name="Error End Concurrent" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerBE_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Normal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1" name="Manual Step">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Normal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="TimerBE_1" attachedToRef="UserTask_1" cancelActivity="false">
      <bpmn:outgoing>Flow_Error</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Normal" name="Normal End">
      <bpmn:incoming>Flow_Normal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Error" name="Timer Error">
      <bpmn:incoming>Flow_Error</bpmn:incoming>
      <bpmn:errorEventDefinition>
        <bpmn:extensionElements>
          <bfw:errorCode>TIMEOUT_ERROR</bfw:errorCode>
          <bfw:errorMessage>Timer expired before user completed task</bfw:errorMessage>
        </bpmn:extensionElements>
      </bpmn:errorEventDefinition>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="UserTask_1" />
    <bpmn:sequenceFlow id="Flow_Normal" sourceRef="UserTask_1" targetRef="End_Normal" />
    <bpmn:sequenceFlow id="Flow_Error" sourceRef="TimerBE_1" targetRef="End_Error" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="80" width="558" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="80" width="528" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_1" bpmnElement="UserTask_1">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TimerBE_1" bpmnElement="TimerBE_1">
        <dc:Bounds x="322" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Normal" bpmnElement="End_Normal">
        <dc:Bounds x="482" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Error" bpmnElement="End_Error">
        <dc:Bounds x="482" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Normal" bpmnElement="Flow_Normal">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="482" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Error" bpmnElement="Flow_Error">
        <di:waypoint x="340" y="258" />
        <di:waypoint x="340" y="300" />
        <di:waypoint x="482" y="300" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
