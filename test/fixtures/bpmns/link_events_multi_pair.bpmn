      <bpmn:linkEventDefinition name="A"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="LinkCatch_A" name="Link Catch A">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
