    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_A"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_A" targetRef="LinkThrow_A"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="LinkCatch_A" targetRef="Task_B"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_B" targetRef="LinkThrow_B"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="LinkCatch_B" targetRef="Task_C"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_C" targetRef="End_1"/>
