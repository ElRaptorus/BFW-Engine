    <bpmn:task id="Task_B" name="Task B">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="LinkThrow_B" name="Link Throw B">
