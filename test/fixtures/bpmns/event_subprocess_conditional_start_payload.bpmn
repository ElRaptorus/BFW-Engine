<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_EspConditionalStartPayload">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="EspConditionalStartPayload" />
  </bpmn:collaboration>

  <bpmn:process id="EspConditionalStartPayload" name="Event Subprocess Conditional Start Payload" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_WriteTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Main_UserTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP_Conditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataObjRef_Trigger</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataObject id="DO_Trigger" name="Trigger" />
    <bpmn:dataObjectReference id="DataObjRef_Trigger" name="Trigger" dataObjectRef="DO_Trigger" />

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_WriteTrigger" name="Write Trigger">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_WriteTrigger">
        <bpmn:targetRef>DataObjRef_Trigger</bpmn:targetRef>
        <bpmn:transformation>token.values</bpmn:transformation>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Main_UserTask" name="Main Work">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="UserTask_WriteTrigger" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_WriteTrigger" targetRef="Main_UserTask" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Main_UserTask" targetRef="End_1" />

    <bpmn:subProcess id="ESP_Conditional" name="Conditional Event Subprocess" triggeredByEvent="true">
      <bpmn:startEvent id="ESP_Start" name="Status Matches" isInterrupting="false">
        <bpmn:conditionalEventDefinition id="ESP_CondDef">
          <bpmn:condition>dataObjects.DO_Trigger.status = token.expected</bpmn:condition>
        </bpmn:conditionalEventDefinition>
        <bpmn:outgoing>ESP_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="ESP_Task" name="Handle Condition">
        <bpmn:incoming>ESP_Flow_1</bpmn:incoming>
        <bpmn:outgoing>ESP_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ESP_End" name="ESP Done">
        <bpmn:incoming>ESP_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ESP_Flow_1" sourceRef="ESP_Start" targetRef="ESP_Task" />
      <bpmn:sequenceFlow id="ESP_Flow_2" sourceRef="ESP_Task" targetRef="ESP_End" />
    </bpmn:subProcess>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="80" width="726" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="80" width="696" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_WriteTrigger" bpmnElement="UserTask_WriteTrigger">
        <dc:Bounds x="250" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Main_UserTask" bpmnElement="Main_UserTask">
        <dc:Bounds x="410" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="572" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DataObjRef_Trigger" bpmnElement="DataObjRef_Trigger">
        <dc:Bounds x="282" y="15" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Conditional" bpmnElement="ESP_Conditional" isExpanded="true">
        <dc:Bounds x="200" y="260" width="380" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Start" bpmnElement="ESP_Start">
        <dc:Bounds x="220" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Task" bpmnElement="ESP_Task">
        <dc:Bounds x="300" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_End" bpmnElement="ESP_End">
        <dc:Bounds x="440" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="160" />
        <di:waypoint x="250" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="350" y="160" />
        <di:waypoint x="410" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="510" y="160" />
        <di:waypoint x="572" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_WriteTrigger" bpmnElement="DOA_WriteTrigger">
        <di:waypoint x="300" y="120" />
        <di:waypoint x="300" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_1" bpmnElement="ESP_Flow_1">
        <di:waypoint x="256" y="340" />
        <di:waypoint x="300" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Flow_2" bpmnElement="ESP_Flow_2">
        <di:waypoint x="400" y="340" />
        <di:waypoint x="440" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
