<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  targetNamespace="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_InboxAdhocCancel">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Inbox Ad-hoc Cancel" processRef="InboxAdhocCancelRemaining" />
  </bpmn:collaboration>
  <bpmn:process id="InboxAdhocCancelRemaining" name="Inbox Ad-hoc Cancel Remaining" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AdHoc_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="AdHoc_1" name="Review pair" ordering="Parallel" cancelRemainingInstances="true">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:userTask id="UserTask_Review" name="Review" />
      <bpmn:userTask id="UserTask_Approve" name="Approve" />
      <bpmn:completionCondition>performedActivities &gt;= 1</bpmn:completionCondition>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="AdHoc_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="AdHoc_1" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="640" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="610" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AdHoc_1" bpmnElement="AdHoc_1">
        <dc:Bounds x="260" y="120" width="280" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_Review" bpmnElement="UserTask_Review">
        <dc:Bounds x="290" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_Approve" bpmnElement="UserTask_Approve">
        <dc:Bounds x="410" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="620" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="540" y="200" />
        <di:waypoint x="620" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
