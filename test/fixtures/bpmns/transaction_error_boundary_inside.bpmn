<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:evil="https://evilengine.dev/schema/bpmn"
                  targetNamespace="https://evilengine.dev/schema/bpmn"
                  id="Definitions_1">

  <!--
    TX-5: Error boundary inside transaction routes to Cancel End.
    Task A completes. Task B fatals (service task with bad handler).
    Error boundary on Task B catches it, routes to Compensate Throw, then Cancel End.
    Cancel Boundary on shell fires, parent continues to End_Cancelled.
  -->

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Transaction Error Boundary Inside" processRef="transaction_error_boundary_inside" />
  </bpmn:collaboration>

  <bpmn:process id="transaction_error_boundary_inside" name="Transaction Error Boundary Inside" isExecutable="true">
    <bpmn:extensionElements>
      <evil:version>1.0.0</evil:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tx_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Normal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:transaction id="Tx_1" name="My Transaction">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>

      <bpmn:laneSet id="LaneSet_Tx">
        <bpmn:lane id="Lane_Tx" name="default">
          <bpmn:flowNodeRef>Tx_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_TaskA</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_CompBoundaryA</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_CompHandlerA</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_TaskB</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_ErrorBoundaryB</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_CompThrow</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_CancelEnd</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Tx_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>

      <bpmn:startEvent id="Tx_Start" name="TX Start">
        <bpmn:outgoing>TxFlow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:task id="Tx_TaskA" name="Task A">
        <bpmn:incoming>TxFlow_1</bpmn:incoming>
        <bpmn:outgoing>TxFlow_2</bpmn:outgoing>
      </bpmn:task>

      <bpmn:boundaryEvent id="Tx_CompBoundaryA" name="Compensate A" attachedToRef="Tx_TaskA" cancelActivity="false">
        <bpmn:compensateEventDefinition />
      </bpmn:boundaryEvent>

      <bpmn:task id="Tx_CompHandlerA" name="Compensate Task A" isForCompensation="true" />

      <bpmn:serviceTask id="Tx_TaskB" name="Task B (fails)" implementation="nonexistent_handler_xyz">
        <bpmn:incoming>TxFlow_2</bpmn:incoming>
        <bpmn:outgoing>TxFlow_5</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:boundaryEvent id="Tx_ErrorBoundaryB" name="Error on B" attachedToRef="Tx_TaskB" cancelActivity="true">
        <bpmn:outgoing>TxFlow_3</bpmn:outgoing>
        <bpmn:errorEventDefinition />
      </bpmn:boundaryEvent>

      <bpmn:intermediateThrowEvent id="Tx_CompThrow" name="Compensate">
        <bpmn:incoming>TxFlow_3</bpmn:incoming>
        <bpmn:outgoing>TxFlow_4</bpmn:outgoing>
        <bpmn:compensateEventDefinition />
      </bpmn:intermediateThrowEvent>

      <bpmn:endEvent id="Tx_CancelEnd" name="Cancel">
        <bpmn:incoming>TxFlow_4</bpmn:incoming>
        <bpmn:cancelEventDefinition />
      </bpmn:endEvent>

      <bpmn:endEvent id="Tx_End" name="TX End">
        <bpmn:incoming>TxFlow_5</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="TxFlow_1" sourceRef="Tx_Start" targetRef="Tx_TaskA" />
      <bpmn:sequenceFlow id="TxFlow_2" sourceRef="Tx_TaskA" targetRef="Tx_TaskB" />
      <bpmn:sequenceFlow id="TxFlow_3" sourceRef="Tx_ErrorBoundaryB" targetRef="Tx_CompThrow" />
      <bpmn:sequenceFlow id="TxFlow_4" sourceRef="Tx_CompThrow" targetRef="Tx_CancelEnd" />
      <bpmn:sequenceFlow id="TxFlow_5" sourceRef="Tx_TaskB" targetRef="Tx_End" />

      <bpmn:association id="Assoc_CompA" sourceRef="Tx_CompBoundaryA" targetRef="Tx_CompHandlerA" associationDirection="One" />
    </bpmn:transaction>

    <bpmn:boundaryEvent id="Boundary_Cancel" cancelActivity="true" attachedToRef="Tx_1">
      <bpmn:outgoing>Flow_Cancel</bpmn:outgoing>
      <bpmn:cancelEventDefinition />
    </bpmn:boundaryEvent>

    <bpmn:endEvent id="End_Cancelled" name="Order Cancelled">
      <bpmn:incoming>Flow_Cancel</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Normal" name="End Normal">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Tx_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Tx_1" targetRef="End_Normal" />
    <bpmn:sequenceFlow id="Flow_Cancel" sourceRef="Boundary_Cancel" targetRef="End_Cancelled" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="transaction_error_boundary_inside">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_1" bpmnElement="Tx_1" isExpanded="true">
        <dc:Bounds x="260" y="60" width="700" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_Start" bpmnElement="Tx_Start">
        <dc:Bounds x="292" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_TaskA" bpmnElement="Tx_TaskA">
        <dc:Bounds x="380" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_CompBoundaryA" bpmnElement="Tx_CompBoundaryA">
        <dc:Bounds x="412" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_CompHandlerA" bpmnElement="Tx_CompHandlerA">
        <dc:Bounds x="380" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_TaskB" bpmnElement="Tx_TaskB">
        <dc:Bounds x="540" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_ErrorBoundaryB" bpmnElement="Tx_ErrorBoundaryB">
        <dc:Bounds x="572" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_CompThrow" bpmnElement="Tx_CompThrow">
        <dc:Bounds x="572" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_CancelEnd" bpmnElement="Tx_CancelEnd">
        <dc:Bounds x="700" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Tx_End" bpmnElement="Tx_End">
        <dc:Bounds x="700" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Cancel" bpmnElement="Boundary_Cancel">
        <dc:Bounds x="442" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cancelled" bpmnElement="End_Cancelled">
        <dc:Bounds x="1032" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Normal" bpmnElement="End_Normal">
        <dc:Bounds x="1032" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TxFlow_1" bpmnElement="TxFlow_1">
        <di:waypoint x="328" y="200" />
        <di:waypoint x="380" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TxFlow_2" bpmnElement="TxFlow_2">
        <di:waypoint x="480" y="200" />
        <di:waypoint x="540" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TxFlow_3" bpmnElement="TxFlow_3">
        <di:waypoint x="590" y="258" />
        <di:waypoint x="590" y="312" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TxFlow_4" bpmnElement="TxFlow_4">
        <di:waypoint x="608" y="330" />
        <di:waypoint x="700" y="330" />
        <di:waypoint x="700" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TxFlow_5" bpmnElement="TxFlow_5">
        <di:waypoint x="640" y="120" />
        <di:waypoint x="700" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="960" y="200" />
        <di:waypoint x="1032" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Cancel" bpmnElement="Flow_Cancel">
        <di:waypoint x="460" y="378" />
        <di:waypoint x="460" y="410" />
        <di:waypoint x="1032" y="410" />
        <di:waypoint x="1032" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_CompA" bpmnElement="Assoc_CompA">
        <di:waypoint x="430" y="258" />
        <di:waypoint x="430" y="310" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
