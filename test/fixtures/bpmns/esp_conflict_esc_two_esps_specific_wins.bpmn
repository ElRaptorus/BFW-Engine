<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:evil="https://evilengine.dev/schema/bpmn"
  targetNamespace="https://evilengine.dev/schema/bpmn"
  id="Definitions_TwoEspsSpecific">

  <bpmn:escalation id="Esc_VF" name="validation-failed" escalationCode="VALIDATION_FAILED" />

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="EspConflictEscTwoEspsSpecificWins" />
  </bpmn:collaboration>

  <bpmn:process id="EspConflictEscTwoEspsSpecificWins" name="Two ESPs: Specific Wins" isExecutable="true">
    <bpmn:extensionElements>
      <evil:version>1.0.0</evil:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Normal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:intermediateThrowEvent id="Throw_Esc" name="Throw VALIDATION_FAILED">
      <bpmn:escalationEventDefinition id="Throw_EscDef" escalationRef="Esc_VF" />
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_Normal" name="Normal End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ESP 1: Specific code VALIDATION_FAILED -->
    <bpmn:subProcess id="ESP_Specific" name="ESP Specific" triggeredByEvent="true">
      <bpmn:startEvent id="ESP_Specific_Start" name="Specific Esc Start" isInterrupting="false">
        <bpmn:escalationEventDefinition id="ESP_Specific_EscDef" escalationRef="Esc_VF" />
        <bpmn:outgoing>ESP_Specific_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="ESP_Specific_End" name="Specific ESP End">
        <bpmn:incoming>ESP_Specific_Flow_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ESP_Specific_Flow_1" sourceRef="ESP_Specific_Start" targetRef="ESP_Specific_End" />
    </bpmn:subProcess>

    <!-- ESP 2: Catch-all (no escalationRef) -->
    <bpmn:subProcess id="ESP_CatchAll" name="ESP Catch-All" triggeredByEvent="true">
      <bpmn:startEvent id="ESP_CatchAll_Start" name="CatchAll Esc Start" isInterrupting="false">
        <bpmn:escalationEventDefinition id="ESP_CatchAll_EscDef" />
        <bpmn:outgoing>ESP_CatchAll_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="ESP_CatchAll_End" name="CatchAll ESP End">
        <bpmn:incoming>ESP_CatchAll_Flow_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ESP_CatchAll_Flow_1" sourceRef="ESP_CatchAll_Start" targetRef="ESP_CatchAll_End" />
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Throw_Esc" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Throw_Esc" targetRef="End_Normal" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="60" width="626" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="60" width="596" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Esc" bpmnElement="Throw_Esc">
        <dc:Bounds x="322" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Normal" bpmnElement="End_Normal">
        <dc:Bounds x="482" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Specific" bpmnElement="ESP_Specific" isExpanded="true">
        <dc:Bounds x="160" y="230" width="300" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Specific_Start" bpmnElement="ESP_Specific_Start">
        <dc:Bounds x="190" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_Specific_End" bpmnElement="ESP_Specific_End">
        <dc:Bounds x="360" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_CatchAll" bpmnElement="ESP_CatchAll" isExpanded="true">
        <dc:Bounds x="160" y="370" width="300" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_CatchAll_Start" bpmnElement="ESP_CatchAll_Start">
        <dc:Bounds x="190" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ESP_CatchAll_End" bpmnElement="ESP_CatchAll_End">
        <dc:Bounds x="360" y="412" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="160" />
        <di:waypoint x="322" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="358" y="160" />
        <di:waypoint x="482" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_Specific_Flow_1" bpmnElement="ESP_Specific_Flow_1">
        <di:waypoint x="226" y="290" />
        <di:waypoint x="360" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ESP_CatchAll_Flow_1" bpmnElement="ESP_CatchAll_Flow_1">
        <di:waypoint x="226" y="430" />
        <di:waypoint x="360" y="430" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
