        <di:waypoint x="407" y="250" />
        <di:waypoint x="450" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Direct" bpmnElement="Flow_Direct">
        <di:waypoint x="365" y="200" />
        <di:waypoint x="407" y="200" />
        <di:waypoint x="407" y="150" />
        <di:waypoint x="450" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="550" y="250" />
        <di:waypoint x="596" y="250" />
        <di:waypoint x="596" y="316" />
        <di:waypoint x="642" y="316" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
