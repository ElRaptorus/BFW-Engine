<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_XOR_CA"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_XorToCallActivity" name="XOR to Call Activity" processRef="XorToCallActivity" />
  </bpmn:collaboration>
  <bpmn:process id="XorToCallActivity" name="XOR to Call Activity" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XOR_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Direct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Direct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start"/>
    <bpmn:exclusiveGateway id="XOR_1" name="Check Amount"/>
    <bpmn:callActivity id="CA_1" name="Call Child" calledElement="ChildProcess"/>
    <bpmn:boundaryEvent id="BE_1" attachedToRef="CA_1">
      <bpmn:errorEventDefinition/>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Direct" name="Direct Path"/>
    <bpmn:endEvent id="End_CA" name="CA Done"/>
    <bpmn:endEvent id="End_Direct" name="Direct Done"/>
    <bpmn:endEvent id="End_Error" name="Error Handled"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="XOR_1"/>
    <bpmn:sequenceFlow id="Flow_CA" sourceRef="XOR_1" targetRef="CA_1">
      <bpmn:conditionExpression>token.route = "call"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Direct" sourceRef="XOR_1" targetRef="Task_Direct">
      <bpmn:conditionExpression>token.route = "direct"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="CA_1" targetRef="End_CA"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Direct" targetRef="End_Direct"/>
    <bpmn:sequenceFlow id="Flow_BE" sourceRef="BE_1" targetRef="End_Error"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_XorToCallActivity" bpmnElement="Participant_XorToCallActivity" isHorizontal="true">
        <dc:Bounds x="82" y="68" width="646" height="296" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="68" width="616" height="296" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
