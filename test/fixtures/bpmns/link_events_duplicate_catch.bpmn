  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_LinkEventsDuplicateCatchProcess" name="Link Events Duplicate Catch" processRef="LinkEventsDuplicateCatchProcess" />
  </bpmn:collaboration>
  <bpmn:process id="LinkEventsDuplicateCatchProcess" name="Link Events Duplicate Catch" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LinkThrow_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LinkCatch_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LinkCatch_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_A" name="Task A">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="LinkThrow_A" name="Link Throw A">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:linkEventDefinition name="A"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="LinkCatch_A1" name="Link Catch A (1)">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:linkEventDefinition name="A"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="LinkCatch_A2" name="Link Catch A (2)">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:linkEventDefinition name="A"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_1" name="End 1">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_2" name="End 2">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_A"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_A" targetRef="LinkThrow_A"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="LinkCatch_A1" targetRef="End_1"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="LinkCatch_A2" targetRef="End_2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_LinkEventsDuplicateCatchProcess" bpmnElement="Participant_LinkEventsDuplicateCatchProcess" isHorizontal="true">
        <dc:Bounds x="82" y="52" width="486" height="296" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
