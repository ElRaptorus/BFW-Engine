<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_1">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="AdHocInsideAdHocInvalid" />
  </bpmn:collaboration>

  <bpmn:process id="AdHocInsideAdHocInvalid" name="Ad-hoc Inside Ad-hoc Invalid" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OuterAdHoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:adHocSubProcess id="OuterAdHoc" name="Outer Ad-hoc">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>

      <bpmn:adHocSubProcess id="InnerAdHoc" name="Inner Ad-hoc (Invalid)">
        <bpmn:scriptTask id="InnerScript" name="Inner Script" scriptFormat="feel">
          <bpmn:script>{ inner: "done" }</bpmn:script>
        </bpmn:scriptTask>
      </bpmn:adHocSubProcess>

      <bpmn:scriptTask id="OuterScript" name="Outer Script" scriptFormat="feel">
        <bpmn:script>{ outer: "done" }</bpmn:script>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="OuterAdHoc" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="OuterAdHoc" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="82" y="80" width="780" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="80" width="750" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_OuterAdHoc" bpmnElement="OuterAdHoc" isExpanded="true">
        <dc:Bounds x="280" y="110" width="420" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InnerAdHoc" bpmnElement="InnerAdHoc" isExpanded="true">
        <dc:Bounds x="310" y="140" width="200" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InnerScript" bpmnElement="InnerScript">
        <dc:Bounds x="340" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_OuterScript" bpmnElement="OuterScript">
        <dc:Bounds x="540" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="760" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="250" />
        <di:waypoint x="280" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="700" y="250" />
        <di:waypoint x="760" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
