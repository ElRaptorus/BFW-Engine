<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:evil="https://evilengine.dev/schema/bpmn"
  targetNamespace="https://evilengine.dev/schema/bpmn"
  id="Definitions_1">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="CompensationUnfinishedActivity" />
  </bpmn:collaboration>

  <!--
    COMP-10: Compensation throw while a compensable activity is still running.
    
    Parallel gateway splits into two branches:
    - Branch 1: Task_A (auto-completes) → compensation throw (broadcast)
    - Branch 2: UserTask_B (compensable, stays in :waiting)
    
    Task_A has no compensation handler (not compensable).
    UserTask_B HAS a compensation boundary + handler, BUT is still waiting
    when the throw fires. Since UserTask_B hasn't completed, it must NOT
    appear in the compensation registry, and its handler must NOT fire.
    
    Expected: compensation throw has 0 targets, PI continues, user task
    is still waiting. Then we finish the user task and PI completes.
  -->

  <bpmn:process id="CompensationUnfinishedActivity" name="Compensation Unfinished Activity" isExecutable="true">
    <bpmn:extensionElements>
      <evil:version>1.0.0</evil:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_Compensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Branch1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Comp_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompHandler_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Branch2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_ToFork</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="Fork_1" name="Fork">
      <bpmn:incoming>Flow_ToFork</bpmn:incoming>
      <bpmn:outgoing>Flow_Branch1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Branch2</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch 1: Task_A completes immediately, then compensation throw -->
    <bpmn:task id="Task_A" name="Task A">
      <bpmn:incoming>Flow_Branch1</bpmn:incoming>
      <bpmn:outgoing>Flow_ToThrow</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateThrowEvent id="Throw_Compensation" name="Throw Compensation">
      <bpmn:incoming>Flow_ToThrow</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd1</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_Branch1" name="End Branch 1">
      <bpmn:incoming>Flow_ToEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Branch 2: UserTask_B is compensable but waits for user input -->
    <bpmn:userTask id="UserTask_B" name="User Task B">
      <bpmn:incoming>Flow_Branch2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BE_Comp_B" name="Compensate B" attachedToRef="UserTask_B" cancelActivity="false">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_CompHandler_B" name="Comp Handler B" isForCompensation="true" />

    <bpmn:endEvent id="End_Branch2" name="End Branch 2">
      <bpmn:incoming>Flow_ToEnd2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToFork" sourceRef="Start_1" targetRef="Fork_1" />
    <bpmn:sequenceFlow id="Flow_Branch1" sourceRef="Fork_1" targetRef="Task_A" />
    <bpmn:sequenceFlow id="Flow_Branch2" sourceRef="Fork_1" targetRef="UserTask_B" />
    <bpmn:sequenceFlow id="Flow_ToThrow" sourceRef="Task_A" targetRef="Throw_Compensation" />
    <bpmn:sequenceFlow id="Flow_ToEnd1" sourceRef="Throw_Compensation" targetRef="End_Branch1" />
    <bpmn:sequenceFlow id="Flow_ToEnd2" sourceRef="UserTask_B" targetRef="End_Branch2" />

    <bpmn:association id="Assoc_Comp_B" sourceRef="BE_Comp_B" targetRef="Task_CompHandler_B" associationDirection="One" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="60" width="700" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="670" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="182" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork_1" bpmnElement="Fork_1">
        <dc:Bounds x="270" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_A" bpmnElement="Task_A">
        <dc:Bounds x="380" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Compensation" bpmnElement="Throw_Compensation">
        <dc:Bounds x="542" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Branch1" bpmnElement="End_Branch1">
        <dc:Bounds x="642" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_B" bpmnElement="UserTask_B">
        <dc:Bounds x="380" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BE_Comp_B" bpmnElement="BE_Comp_B">
        <dc:Bounds x="412" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CompHandler_B" bpmnElement="Task_CompHandler_B">
        <dc:Bounds x="380" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Branch2" bpmnElement="End_Branch2">
        <dc:Bounds x="542" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_ToFork" bpmnElement="Flow_ToFork">
        <di:waypoint x="218" y="200" />
        <di:waypoint x="270" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Branch1" bpmnElement="Flow_Branch1">
        <di:waypoint x="295" y="175" />
        <di:waypoint x="295" y="140" />
        <di:waypoint x="380" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Branch2" bpmnElement="Flow_Branch2">
        <di:waypoint x="295" y="225" />
        <di:waypoint x="295" y="300" />
        <di:waypoint x="380" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ToThrow" bpmnElement="Flow_ToThrow">
        <di:waypoint x="480" y="140" />
        <di:waypoint x="542" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ToEnd1" bpmnElement="Flow_ToEnd1">
        <di:waypoint x="578" y="140" />
        <di:waypoint x="642" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ToEnd2" bpmnElement="Flow_ToEnd2">
        <di:waypoint x="480" y="300" />
        <di:waypoint x="542" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Comp_B" bpmnElement="Assoc_Comp_B">
        <di:waypoint x="430" y="358" />
        <di:waypoint x="430" y="390" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
