<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_1">

  <bpmn:signal id="Signal_1" name="ebg-test-signal" />

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Default" processRef="EbgSignalTimer" />
  </bpmn:collaboration>

  <bpmn:process id="EbgSignalTimer" name="EBG Signal vs Timer" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignalCatch_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerCatch_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:eventBasedGateway id="EBG_1" name="Wait for Event">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Signal</bpmn:outgoing>
      <bpmn:outgoing>Flow_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="SignalCatch_1" name="Signal Catch">
      <bpmn:incoming>Flow_Signal</bpmn:incoming>
      <bpmn:outgoing>Flow_Signal_End</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_1" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="TimerCatch_1" name="Timer Catch">
      <bpmn:incoming>Flow_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_End</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_1" name="Done">
      <bpmn:incoming>Flow_Signal_End</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="EBG_1" />
    <bpmn:sequenceFlow id="Flow_Signal" sourceRef="EBG_1" targetRef="SignalCatch_1" />
    <bpmn:sequenceFlow id="Flow_Timer" sourceRef="EBG_1" targetRef="TimerCatch_1" />
    <bpmn:sequenceFlow id="Flow_Signal_End" sourceRef="SignalCatch_1" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_Timer_End" sourceRef="TimerCatch_1" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="EbgSignalTimer">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EBG_1" bpmnElement="EBG_1">
        <dc:Bounds x="300" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SignalCatch_1" bpmnElement="SignalCatch_1">
        <dc:Bounds x="452" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TimerCatch_1" bpmnElement="TimerCatch_1">
        <dc:Bounds x="452" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="612" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="300" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Signal" bpmnElement="Flow_Signal">
        <di:waypoint x="325" y="175" />
        <di:waypoint x="325" y="130" />
        <di:waypoint x="452" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Timer" bpmnElement="Flow_Timer">
        <di:waypoint x="325" y="225" />
        <di:waypoint x="325" y="270" />
        <di:waypoint x="452" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Signal_End" bpmnElement="Flow_Signal_End">
        <di:waypoint x="488" y="130" />
        <di:waypoint x="630" y="130" />
        <di:waypoint x="630" y="182" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Timer_End" bpmnElement="Flow_Timer_End">
        <di:waypoint x="488" y="270" />
        <di:waypoint x="630" y="270" />
        <di:waypoint x="630" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
