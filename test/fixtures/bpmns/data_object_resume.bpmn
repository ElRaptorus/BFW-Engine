<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_DataObjectResume" name="Data Object Resume" processRef="DataObjectResume" />
  </bpmn:collaboration>
  <bpmn:process id="DataObjectResume" name="Data Object Resume" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_default" name="default">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_Write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataObject id="DO_1" name="PersistentData"/>
    <bpmn:dataObjectReference id="DOR_1" dataObjectRef="DO_1"/>

    <bpmn:startEvent id="Start_1" name="Start"/>

    <!-- Writes to DO before the UserTask pause point -->
    <bpmn:scriptTask id="ScriptTask_Write" name="Write DO" scriptFormat="feel">
      <bpmn:script>{"persisted_value": token.amount * 7}</bpmn:script>
      <bpmn:dataOutputAssociation id="DOA_1">
        <bpmn:targetRef>DOR_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:scriptTask>

    <!-- UserTask pauses execution — resume happens here -->
    <bpmn:userTask id="UserTask_1" name="Approval"/>

    <!-- Reads from rehydrated DO cache after resume -->
    <bpmn:scriptTask id="ScriptTask_Read" name="Read DO" scriptFormat="feel">
      <bpmn:script>{"read_value": dataObjects.DO_1.persisted_value}</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="End_1" name="End"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="ScriptTask_Write"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ScriptTask_Write" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="UserTask_1" targetRef="ScriptTask_Read"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="ScriptTask_Read" targetRef="End_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_DataObjectResume" bpmnElement="Participant_DataObjectResume" isHorizontal="true">
        <dc:Bounds x="82" y="130" width="806" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_default" bpmnElement="Lane_default" isHorizontal="true">
        <dc:Bounds x="112" y="130" width="776" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ScriptTask_Write" bpmnElement="ScriptTask_Write">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_1" bpmnElement="UserTask_1">
        <dc:Bounds x="450" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ScriptTask_Read" bpmnElement="ScriptTask_Read">
        <dc:Bounds x="610" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="802" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DOR_1" bpmnElement="DOR_1">
        <dc:Bounds x="162" y="300" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="450" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="550" y="200" />
        <di:waypoint x="610" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="710" y="200" />
        <di:waypoint x="802" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
