<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
  targetNamespace="https://bifrostforge.world/schema/bpmn"
  id="Definitions_CompensationScopeEspUncaughtEnd">

  <bpmn:error id="Error_Undo" name="Undo Failed" errorCode="UNDO_FAILED" />
  <bpmn:escalation id="Escalation_Undo" name="Undo Escalated" escalationCode="UNDO_ESCALATED" />

  <bpmn:process id="CompensationScopeEspUncaughtEnd" name="Compensation Scope ESP Uncaught End" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>

    <bpmn:startEvent id="Start_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:subProcess id="SubProcess_Booking" name="Booking">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>

      <bpmn:startEvent id="Booking_Start" name="Booking Start">
        <bpmn:outgoing>Booking_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:task id="Task_Book" name="Book">
        <bpmn:incoming>Booking_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Booking_Flow_2</bpmn:outgoing>
      </bpmn:task>

      <bpmn:endEvent id="Booking_End" name="Booked">
        <bpmn:incoming>Booking_Flow_2</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Booking_Flow_1" sourceRef="Booking_Start" targetRef="Task_Book" />
      <bpmn:sequenceFlow id="Booking_Flow_2" sourceRef="Task_Book" targetRef="Booking_End" />

      <bpmn:subProcess id="ESP_Comp_Booking" name="Compensate Booking Scope" triggeredByEvent="true">
        <bpmn:startEvent id="ESP_Start" name="Compensation Start">
          <bpmn:compensateEventDefinition />
          <bpmn:outgoing>ESP_Flow_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="UT_Decide" name="Try To Undo">
          <bpmn:incoming>ESP_Flow_1</bpmn:incoming>
          <bpmn:outgoing>ESP_Flow_2</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:exclusiveGateway id="Gateway_Outcome" name="Outcome?" default="ESP_Flow_Escalation">
          <bpmn:incoming>ESP_Flow_2</bpmn:incoming>
          <bpmn:outgoing>ESP_Flow_Error</bpmn:outgoing>
          <bpmn:outgoing>ESP_Flow_Escalation</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="ESP_End_Error" name="Undo Failed">
          <bpmn:incoming>ESP_Flow_Error</bpmn:incoming>
          <bpmn:errorEventDefinition errorRef="Error_Undo" />
        </bpmn:endEvent>
        <bpmn:endEvent id="ESP_End_Escalation" name="Undo Escalated">
          <bpmn:incoming>ESP_Flow_Escalation</bpmn:incoming>
          <bpmn:escalationEventDefinition escalationRef="Escalation_Undo" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="ESP_Flow_1" sourceRef="ESP_Start" targetRef="UT_Decide" />
        <bpmn:sequenceFlow id="ESP_Flow_2" sourceRef="UT_Decide" targetRef="Gateway_Outcome" />
        <bpmn:sequenceFlow id="ESP_Flow_Error" sourceRef="Gateway_Outcome" targetRef="ESP_End_Error">
          <bpmn:conditionExpression>token.values.outcome = "error"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="ESP_Flow_Escalation" sourceRef="Gateway_Outcome" targetRef="ESP_End_Escalation" />
      </bpmn:subProcess>
    </bpmn:subProcess>

    <bpmn:intermediateThrowEvent id="Throw_Comp" name="Compensate">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>

    <bpmn:endEvent id="End_1" name="End">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="SubProcess_Booking" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="SubProcess_Booking" targetRef="Throw_Comp" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Throw_Comp" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="CompensationScopeEspUncaughtEnd">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_Booking" bpmnElement="SubProcess_Booking">
        <dc:Bounds x="290" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Throw_Comp" bpmnElement="Throw_Comp">
        <dc:Bounds x="482" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="612" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="390" y="200" />
        <di:waypoint x="482" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="518" y="200" />
        <di:waypoint x="612" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
