<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bfw="https://bifrostforge.world/schema/bpmn"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_LaneVisibility" name="Lane Visibility Two Lanes" processRef="LaneVisibilityTwoLanes" />
  </bpmn:collaboration>
  <bpmn:process id="LaneVisibilityTwoLanes" name="Lane Visibility Two Lanes" isExecutable="true">
    <bpmn:extensionElements>
      <bfw:version>1.0.0</bfw:version>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_A" name="LaneA">
        <bpmn:flowNodeRef>UserTask_A</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_B" name="LaneB">
        <bpmn:flowNodeRef>UserTask_B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_To_A</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_B</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UserTask_A" name="Task A">
      <bpmn:incoming>Flow_To_A</bpmn:incoming>
      <bpmn:outgoing>Flow_From_A</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_B" name="Task B">
      <bpmn:incoming>Flow_To_B</bpmn:incoming>
      <bpmn:outgoing>Flow_From_B</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>Flow_From_A</bpmn:incoming>
      <bpmn:incoming>Flow_From_B</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_1" targetRef="Gateway_Split"/>
    <bpmn:sequenceFlow id="Flow_To_A" sourceRef="Gateway_Split" targetRef="UserTask_A"/>
    <bpmn:sequenceFlow id="Flow_To_B" sourceRef="Gateway_Split" targetRef="UserTask_B"/>
    <bpmn:sequenceFlow id="Flow_From_A" sourceRef="UserTask_A" targetRef="Gateway_Join"/>
    <bpmn:sequenceFlow id="Flow_From_B" sourceRef="UserTask_B" targetRef="Gateway_Join"/>
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Gateway_Join" targetRef="EndEvent_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Shape_Participant_LaneVisibility" bpmnElement="Participant_LaneVisibility" isHorizontal="true">
        <dc:Bounds x="82" y="80" width="720" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_A" bpmnElement="Lane_A" isHorizontal="true">
        <dc:Bounds x="112" y="80" width="690" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_B" bpmnElement="Lane_B" isHorizontal="true">
        <dc:Bounds x="112" y="205" width="690" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="187" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Split" bpmnElement="Gateway_Split">
        <dc:Bounds x="235" y="180" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_A" bpmnElement="UserTask_A">
        <dc:Bounds x="340" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_B" bpmnElement="UserTask_B">
        <dc:Bounds x="340" y="228" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Join" bpmnElement="Gateway_Join">
        <dc:Bounds x="505" y="180" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="622" y="187" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start" bpmnElement="Flow_Start">
        <di:waypoint x="188" y="205" />
        <di:waypoint x="235" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_A" bpmnElement="Flow_To_A">
        <di:waypoint x="260" y="180" />
        <di:waypoint x="260" y="142" />
        <di:waypoint x="340" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_To_B" bpmnElement="Flow_To_B">
        <di:waypoint x="260" y="230" />
        <di:waypoint x="260" y="268" />
        <di:waypoint x="340" y="268" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_From_A" bpmnElement="Flow_From_A">
        <di:waypoint x="440" y="142" />
        <di:waypoint x="530" y="142" />
        <di:waypoint x="530" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_From_B" bpmnElement="Flow_From_B">
        <di:waypoint x="440" y="268" />
        <di:waypoint x="530" y="268" />
        <di:waypoint x="530" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_End" bpmnElement="Flow_End">
        <di:waypoint x="555" y="205" />
        <di:waypoint x="622" y="205" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
