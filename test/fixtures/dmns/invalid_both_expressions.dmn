<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_invalid_both" name="Invalid Both Expressions"
  namespace="https://example.com/dmn/invalid"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <inputData id="InputData_value" name="value">
    <variable name="value" typeRef="number"/>
  </inputData>

  <decision id="Decision_invalid_both" name="Invalid Both Table And Literal">
    <informationRequirement id="ir_value">
      <requiredInput href="#InputData_value"/>
    </informationRequirement>
    <decisionTable id="dt_invalid" hitPolicy="UNIQUE">
      <input id="Input_value" label="Value">
        <inputExpression typeRef="number">value</inputExpression>
      </input>
      <output id="Output_result" label="Result" name="result" typeRef="number"/>
      <rule id="Rule_1">
        <inputEntry id="IE_1"><text>&gt; 0</text></inputEntry>
        <outputEntry id="OE_1"><text>value</text></outputEntry>
      </rule>
    </decisionTable>
    <literalExpression id="literal_invalid" typeRef="number">
      <text>value * 2</text>
    </literalExpression>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_invalid_both" dmnElementRef="Decision_invalid_both">
        <dc:Bounds x="130" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_value" dmnElementRef="InputData_value">
        <dc:Bounds x="130" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_value" dmnElementRef="ir_value">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
