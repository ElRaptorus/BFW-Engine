<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_invalid_none" name="Invalid No Expression"
  namespace="https://example.com/dmn/invalid"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <inputData id="InputData_value" name="value">
    <variable name="value" typeRef="number"/>
  </inputData>

  <decision id="Decision_invalid_none" name="Invalid No Table Or Literal">
    <informationRequirement id="ir_value">
      <requiredInput href="#InputData_value"/>
    </informationRequirement>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_invalid_none" dmnElementRef="Decision_invalid_none">
        <dc:Bounds x="130" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_value" dmnElementRef="InputData_value">
        <dc:Bounds x="130" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_value" dmnElementRef="ir_value">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
