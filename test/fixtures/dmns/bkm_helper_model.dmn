<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_bkm_helper"
             name="BKM Helper Model"
             namespace="https://bifrostforge.world/test/bkm-helper"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <businessKnowledgeModel id="BKM_tax_rate" name="Tax Rate Calculator">
    <variable id="var_bkm_tax" name="Tax Rate Calculator"/>
    <encapsulatedLogic id="FL_tax" kind="FEEL">
      <formalParameter id="FP_amount" name="amount" typeRef="number"/>
      <literalExpression id="LE_tax">
        <text>if amount > 10000 then 0.20 else 0.10</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_BKM_tax_rate" dmnElementRef="BKM_tax_rate">
        <dc:Bounds x="100" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
