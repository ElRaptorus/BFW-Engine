<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_sum" name="Sum Expression"
  namespace="https://example.com/dmn/sum"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <inputData id="InputData_x" name="x">
    <variable name="x" typeRef="number"/>
  </inputData>

  <inputData id="InputData_y" name="y">
    <variable name="y" typeRef="number"/>
  </inputData>

  <decision id="Decision_sum" name="Sum of x and y">
    <informationRequirement id="ir_x">
      <requiredInput href="#InputData_x"/>
    </informationRequirement>
    <informationRequirement id="ir_y">
      <requiredInput href="#InputData_y"/>
    </informationRequirement>
    <literalExpression id="literal_sum" typeRef="number">
      <text>x + y</text>
    </literalExpression>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_sum" dmnElementRef="Decision_sum">
        <dc:Bounds x="130" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_x" dmnElementRef="InputData_x">
        <dc:Bounds x="100" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_y" dmnElementRef="InputData_y">
        <dc:Bounds x="340" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_x" dmnElementRef="ir_x">
        <di:waypoint x="190" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_ir_y" dmnElementRef="ir_y">
        <di:waypoint x="430" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
