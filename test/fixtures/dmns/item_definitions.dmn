<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_itemdef" name="Item Definitions Test"
  targetNamespace="https://example.com/dmn/itemdef"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <itemDefinition id="ItemDef_Age" name="tAge">
    <typeRef>number</typeRef>
    <allowedValues>[0..150]</allowedValues>
  </itemDefinition>

  <itemDefinition id="ItemDef_Address" name="tAddress">
    <itemComponent id="ItemComp_Street" name="street">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="ItemComp_City" name="city">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="ItemComp_Zip" name="zipCode">
      <typeRef>string</typeRef>
    </itemComponent>
  </itemDefinition>

  <itemDefinition id="ItemDef_Tags" name="tTagList" isCollection="true">
    <typeRef>string</typeRef>
  </itemDefinition>

  <inputData id="InputData_age" name="customerAge">
    <variable name="customerAge" typeRef="tAge"/>
  </inputData>

  <decision id="Decision_greeting" name="Greeting">
    <informationRequirement id="ir_age">
      <requiredInput href="#InputData_age"/>
    </informationRequirement>
    <literalExpression id="LE_greeting">
      <text>"Hello, customer aged " + string(customerAge)</text>
    </literalExpression>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_greeting" dmnElementRef="Decision_greeting">
        <dc:Bounds x="130" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_age" dmnElementRef="InputData_age">
        <dc:Bounds x="130" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_age" dmnElementRef="ir_age">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
