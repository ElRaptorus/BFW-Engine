<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_mixed" name="Mixed Decisions"
  namespace="https://example.com/dmn/mixed"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">
  <inputData id="InputData_x" name="x" />
  <inputData id="InputData_y" name="y" />
  <decision id="Decision_table" name="Table Decision">
    <informationRequirement id="ir_table_x">
      <requiredInput href="#InputData_x" />
    </informationRequirement>
    <decisionTable id="dt_mixed" hitPolicy="UNIQUE">
      <input id="Input_1" label="X">
        <inputExpression typeRef="number">x</inputExpression>
      </input>
      <output id="Output_1" label="Y" name="y" typeRef="number"/>
      <rule id="Rule_1">
        <inputEntry id="IE_1"><text>&gt; 0</text></inputEntry>
        <outputEntry id="OE_1"><text>1</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_literal" name="Literal Decision">
    <informationRequirement id="ir_literal_x">
      <requiredInput href="#InputData_x" />
    </informationRequirement>
    <informationRequirement id="ir_literal_y">
      <requiredInput href="#InputData_y" />
    </informationRequirement>
    <literalExpression id="le_1" typeRef="number">
      <text>x + y</text>
    </literalExpression>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_literal" dmnElementRef="Decision_literal">
        <dc:Bounds x="100" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_table" dmnElementRef="Decision_table">
        <dc:Bounds x="340" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_x" dmnElementRef="InputData_x">
        <dc:Bounds x="100" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_y" dmnElementRef="InputData_y">
        <dc:Bounds x="340" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_table_x" dmnElementRef="ir_table_x">
        <di:waypoint x="190" y="240"/>
        <di:waypoint x="430" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_ir_literal_x" dmnElementRef="ir_literal_x">
        <di:waypoint x="190" y="240"/>
        <di:waypoint x="190" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_ir_literal_y" dmnElementRef="ir_literal_y">
        <di:waypoint x="430" y="240"/>
        <di:waypoint x="190" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
