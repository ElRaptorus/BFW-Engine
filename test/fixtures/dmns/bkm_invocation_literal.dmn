<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_bkm_invoke_le" name="BKM Invocation Literal"
  namespace="https://example.com/dmn/bkm-invoke-le"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <inputData id="InputData_income" name="income">
    <variable name="income" typeRef="number"/>
  </inputData>

  <inputData id="InputData_rate" name="taxRate">
    <variable name="taxRate" typeRef="number"/>
  </inputData>

  <businessKnowledgeModel id="BKM_tax" name="Tax Calculation">
    <variable id="var_bkm_tax" name="taxAmount" typeRef="number"/>
    <encapsulatedLogic id="EL_tax">
      <formalParameter id="FP_income" name="income" typeRef="number"/>
      <formalParameter id="FP_rate" name="taxRate" typeRef="number"/>
      <literalExpression id="LE_tax" typeRef="number">
        <text>income * taxRate</text>
      </literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>

  <decision id="Decision_tax" name="Tax Decision">
    <variable id="var_tax" name="totalWithTax" typeRef="number"/>
    <informationRequirement id="ir_income">
      <requiredInput href="#InputData_income"/>
    </informationRequirement>
    <informationRequirement id="ir_rate">
      <requiredInput href="#InputData_rate"/>
    </informationRequirement>
    <knowledgeRequirement id="kr_tax">
      <requiredKnowledge href="#BKM_tax"/>
    </knowledgeRequirement>
    <literalExpression id="LE_decision" typeRef="number">
      <text>taxAmount + 100</text>
    </literalExpression>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_BKM_tax" dmnElementRef="BKM_tax">
        <dc:Bounds x="100" y="240" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_tax" dmnElementRef="Decision_tax">
        <dc:Bounds x="130" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_income" dmnElementRef="InputData_income">
        <dc:Bounds x="340" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_rate" dmnElementRef="InputData_rate">
        <dc:Bounds x="580" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_income" dmnElementRef="ir_income">
        <di:waypoint x="430" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_ir_rate" dmnElementRef="ir_rate">
        <di:waypoint x="670" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_kr_tax" dmnElementRef="kr_tax">
        <di:waypoint x="190" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
