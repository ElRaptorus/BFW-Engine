<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_ds_basic"
             name="Decision Service Basic"
             namespace="https://evilengine.dev/test/decision-service-basic"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <inputData id="InputData_age" name="Age" />
  <inputData id="InputData_income" name="Income" />

  <decision id="Decision_risk" name="Risk Score">
    <informationRequirement>
      <requiredInput href="#InputData_age" />
    </informationRequirement>
    <literalExpression>
      <text>if Age &gt; 50 then "high" else "low"</text>
    </literalExpression>
  </decision>

  <decision id="Decision_eligibility" name="Eligibility">
    <informationRequirement>
      <requiredInput href="#InputData_income" />
    </informationRequirement>
    <informationRequirement>
      <requiredDecision href="#Decision_risk" />
    </informationRequirement>
    <literalExpression>
      <text>if Risk Score = "low" and Income &gt; 30000 then "approved" else "denied"</text>
    </literalExpression>
  </decision>

  <decisionService id="DS_eligibility" name="Eligibility Service">
    <outputDecision href="#Decision_eligibility" />
    <encapsulatedDecision href="#Decision_risk" />
    <inputData href="#InputData_age" />
    <inputData href="#InputData_income" />
  </decisionService>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_DS_eligibility" dmnElementRef="DS_eligibility">
        <dc:Bounds x="100" y="380" width="200" height="100"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_eligibility" dmnElementRef="Decision_eligibility">
        <dc:Bounds x="250" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_risk" dmnElementRef="Decision_risk">
        <dc:Bounds x="250" y="240" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_age" dmnElementRef="InputData_age">
        <dc:Bounds x="340" y="380" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_income" dmnElementRef="InputData_income">
        <dc:Bounds x="580" y="380" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_edge_Decision_risk_InputData_age" dmnElementRef="edge_Decision_risk_InputData_age">
        <di:waypoint x="430" y="380"/>
        <di:waypoint x="340" y="320"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_edge_Decision_eligibility_InputData_income" dmnElementRef="edge_Decision_eligibility_InputData_income">
        <di:waypoint x="670" y="380"/>
        <di:waypoint x="340" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_edge_Decision_eligibility_Decision_risk" dmnElementRef="edge_Decision_eligibility_Decision_risk">
        <di:waypoint x="340" y="240"/>
        <di:waypoint x="340" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
