<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_iterators"
             name="Iterator Tests"
             namespace="https://example.com/dmn/iterators"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">
  <inputData id="InputData_numbers" name="numbers"/>

  <decision id="Decision_for" name="For Decision">
    <variable id="var_for" name="forResult"/>
    <informationRequirement id="ir_for">
      <requiredInput href="#InputData_numbers"/>
    </informationRequirement>
    <for id="for_1" iteratorVariable="x">
      <in>
        <literalExpression><text>numbers</text></literalExpression>
      </in>
      <return>
        <literalExpression><text>x * 2</text></literalExpression>
      </return>
    </for>
  </decision>

  <decision id="Decision_every" name="Every Decision">
    <variable id="var_every" name="everyResult"/>
    <informationRequirement id="ir_every">
      <requiredInput href="#InputData_numbers"/>
    </informationRequirement>
    <every id="every_1" iteratorVariable="n">
      <in>
        <literalExpression><text>numbers</text></literalExpression>
      </in>
      <satisfies>
        <literalExpression><text>n > 0</text></literalExpression>
      </satisfies>
    </every>
  </decision>

  <decision id="Decision_some" name="Some Decision">
    <variable id="var_some" name="someResult"/>
    <informationRequirement id="ir_some">
      <requiredInput href="#InputData_numbers"/>
    </informationRequirement>
    <some id="some_1" iteratorVariable="n">
      <in>
        <literalExpression><text>numbers</text></literalExpression>
      </in>
      <satisfies>
        <literalExpression><text>n > 10</text></literalExpression>
      </satisfies>
    </some>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_every" dmnElementRef="Decision_every">
        <dc:Bounds x="100" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_for" dmnElementRef="Decision_for">
        <dc:Bounds x="340" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_Decision_some" dmnElementRef="Decision_some">
        <dc:Bounds x="580" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_numbers" dmnElementRef="InputData_numbers">
        <dc:Bounds x="130" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_for" dmnElementRef="ir_for">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="430" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_ir_every" dmnElementRef="ir_every">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="190" y="180"/>
      </dmndi:DMNEdge>
      <dmndi:DMNEdge id="Edge_ir_some" dmnElementRef="ir_some">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="670" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
