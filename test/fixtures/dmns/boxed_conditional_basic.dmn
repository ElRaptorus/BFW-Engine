<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_conditional"
             name="Conditional Test"
             namespace="https://example.com/dmn/conditional"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">
  <inputData id="InputData_score" name="score"/>
  <decision id="Decision_conditional" name="Conditional Decision">
    <variable id="var_cond" name="conditionalResult" typeRef="string"/>
    <informationRequirement id="ir_score">
      <requiredInput href="#InputData_score"/>
    </informationRequirement>
    <conditional id="cond_1">
      <if>
        <literalExpression><text>score > 100</text></literalExpression>
      </if>
      <then>
        <literalExpression><text>"high"</text></literalExpression>
      </then>
      <else>
        <literalExpression><text>"low"</text></literalExpression>
      </else>
    </conditional>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_conditional" dmnElementRef="Decision_conditional">
        <dc:Bounds x="130" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_score" dmnElementRef="InputData_score">
        <dc:Bounds x="130" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_score" dmnElementRef="ir_score">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
