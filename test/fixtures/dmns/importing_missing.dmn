<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_importing_missing" name="Importing Missing Model"
  targetNamespace="https://example.com/dmn/importing-missing"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">

  <import id="Import_nonexistent"
    namespace="https://example.com/dmn/nonexistent"
    importType="https://www.omg.org/spec/DMN/20191111/MODEL/"/>

  <inputData id="InputData_x" name="x" />

  <decision id="Decision_main" name="Main">
    <informationRequirement id="ir_main_x">
      <requiredInput href="#InputData_x" />
    </informationRequirement>
    <informationRequirement id="ir_main_imported">
      <requiredDecision href="https://example.com/dmn/nonexistent#Decision_remote" />
    </informationRequirement>
    <literalExpression id="LE_main">
      <text>x + 1</text>
    </literalExpression>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="DRD">
      <dmndi:DMNShape id="Shape_Decision_main" dmnElementRef="Decision_main">
        <dc:Bounds x="130" y="100" width="180" height="80"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Shape_InputData_x" dmnElementRef="InputData_x">
        <dc:Bounds x="130" y="240" width="180" height="45"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="Edge_ir_main_x" dmnElementRef="ir_main_x">
        <di:waypoint x="220" y="240"/>
        <di:waypoint x="220" y="180"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
