<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_bkm_multi_output" name="BKM Multi-Output Table"
  namespace="https://example.com/dmn/bkm-multi-output">

  <inputData id="InputData_score" name="score">
    <variable name="score" typeRef="number"/>
  </inputData>

  <businessKnowledgeModel id="BKM_grading" name="Grading Logic">
    <variable id="var_bkm_grading" name="gradingResult" typeRef="Any"/>
    <encapsulatedLogic id="EL_grading" kind="FEEL">
      <formalParameter id="FP_score" name="score" typeRef="number"/>
      <decisionTable id="dt_bkm_grading" hitPolicy="FIRST">
        <input id="Input_bkm_score" label="Score">
          <inputExpression typeRef="number">score</inputExpression>
        </input>
        <output id="Output_grade" label="Grade" name="grade" typeRef="string"/>
        <output id="Output_passed" label="Passed" name="passed" typeRef="boolean"/>
        <rule id="Rule_excellent">
          <inputEntry id="IE_excellent"><text>&gt;= 90</text></inputEntry>
          <outputEntry id="OE_excellent_grade"><text>"A"</text></outputEntry>
          <outputEntry id="OE_excellent_passed"><text>true</text></outputEntry>
        </rule>
        <rule id="Rule_good">
          <inputEntry id="IE_good"><text>&gt;= 70</text></inputEntry>
          <outputEntry id="OE_good_grade"><text>"B"</text></outputEntry>
          <outputEntry id="OE_good_passed"><text>true</text></outputEntry>
        </rule>
        <rule id="Rule_fail">
          <inputEntry id="IE_fail"><text>-</text></inputEntry>
          <outputEntry id="OE_fail_grade"><text>"F"</text></outputEntry>
          <outputEntry id="OE_fail_passed"><text>false</text></outputEntry>
        </rule>
      </decisionTable>
    </encapsulatedLogic>
  </businessKnowledgeModel>

  <decision id="Decision_final" name="Final Grade">
    <variable id="var_decision" name="finalGrade" typeRef="Any"/>
    <informationRequirement id="ir_score">
      <requiredInput href="#InputData_score"/>
    </informationRequirement>
    <knowledgeRequirement id="kr_grading">
      <requiredKnowledge href="#BKM_grading"/>
    </knowledgeRequirement>
    <literalExpression id="LE_final" typeRef="Any">
      <text>gradingResult</text>
    </literalExpression>
  </decision>
</definitions>
