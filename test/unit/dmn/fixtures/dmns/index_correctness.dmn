<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_index_correctness"
  name="Index Correctness"
  namespace="https://bifrostforge.world/dmn/test/index-correctness">

  <inputData id="InputData_tier" name="tier" />
  <inputData id="InputData_region" name="region" />
  <inputData id="InputData_score" name="score" />
  <inputData id="InputData_code" name="code" />

  <!-- Table 1: Fully indexed (all equality literals, no wildcards) -->
  <decision id="Decision_fully_indexed" name="Fully Indexed">
    <variable id="Var_fi" name="result" typeRef="number" />
    <informationRequirement id="IR_fi_tier">
      <requiredInput href="#InputData_tier" />
    </informationRequirement>
    <informationRequirement id="IR_fi_region">
      <requiredInput href="#InputData_region" />
    </informationRequirement>
    <decisionTable id="DT_fully_indexed" hitPolicy="UNIQUE">
      <input id="In_fi_tier" label="tier">
        <inputExpression typeRef="string"><text>tier</text></inputExpression>
      </input>
      <input id="In_fi_region" label="region">
        <inputExpression typeRef="string"><text>region</text></inputExpression>
      </input>
      <output id="Out_fi" label="result" name="result" typeRef="number" />
      <rule id="R_fi_1">
        <inputEntry id="IE_fi_1a"><text>"gold"</text></inputEntry>
        <inputEntry id="IE_fi_1b"><text>"EU"</text></inputEntry>
        <outputEntry id="OE_fi_1"><text>100</text></outputEntry>
      </rule>
      <rule id="R_fi_2">
        <inputEntry id="IE_fi_2a"><text>"gold"</text></inputEntry>
        <inputEntry id="IE_fi_2b"><text>"US"</text></inputEntry>
        <outputEntry id="OE_fi_2"><text>200</text></outputEntry>
      </rule>
      <rule id="R_fi_3">
        <inputEntry id="IE_fi_3a"><text>"silver"</text></inputEntry>
        <inputEntry id="IE_fi_3b"><text>"EU"</text></inputEntry>
        <outputEntry id="OE_fi_3"><text>50</text></outputEntry>
      </rule>
      <rule id="R_fi_4">
        <inputEntry id="IE_fi_4a"><text>"silver"</text></inputEntry>
        <inputEntry id="IE_fi_4b"><text>"US"</text></inputEntry>
        <outputEntry id="OE_fi_4"><text>75</text></outputEntry>
      </rule>
      <rule id="R_fi_5">
        <inputEntry id="IE_fi_5a"><text>"bronze"</text></inputEntry>
        <inputEntry id="IE_fi_5b"><text>"APAC"</text></inputEntry>
        <outputEntry id="OE_fi_5"><text>10</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- Table 2: Indexed with wildcards -->
  <decision id="Decision_with_wildcards" name="With Wildcards">
    <variable id="Var_ww" name="result" typeRef="number" />
    <informationRequirement id="IR_ww_tier">
      <requiredInput href="#InputData_tier" />
    </informationRequirement>
    <informationRequirement id="IR_ww_region">
      <requiredInput href="#InputData_region" />
    </informationRequirement>
    <decisionTable id="DT_with_wildcards" hitPolicy="FIRST">
      <input id="In_ww_tier" label="tier">
        <inputExpression typeRef="string"><text>tier</text></inputExpression>
      </input>
      <input id="In_ww_region" label="region">
        <inputExpression typeRef="string"><text>region</text></inputExpression>
      </input>
      <output id="Out_ww" label="result" name="result" typeRef="number" />
      <rule id="R_ww_1">
        <inputEntry id="IE_ww_1a"><text>"gold"</text></inputEntry>
        <inputEntry id="IE_ww_1b"><text>"EU"</text></inputEntry>
        <outputEntry id="OE_ww_1"><text>100</text></outputEntry>
      </rule>
      <rule id="R_ww_2">
        <inputEntry id="IE_ww_2a"><text>"gold"</text></inputEntry>
        <inputEntry id="IE_ww_2b"><text>-</text></inputEntry>
        <outputEntry id="OE_ww_2"><text>80</text></outputEntry>
      </rule>
      <rule id="R_ww_3">
        <inputEntry id="IE_ww_3a"><text>-</text></inputEntry>
        <inputEntry id="IE_ww_3b"><text>"EU"</text></inputEntry>
        <outputEntry id="OE_ww_3"><text>30</text></outputEntry>
      </rule>
      <rule id="R_ww_4">
        <inputEntry id="IE_ww_4a"><text>-</text></inputEntry>
        <inputEntry id="IE_ww_4b"><text>-</text></inputEntry>
        <outputEntry id="OE_ww_4"><text>10</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- Table 3: Mixed columns (col 1 indexable, col 2 uses FEEL range) -->
  <decision id="Decision_mixed_columns" name="Mixed Columns">
    <variable id="Var_mc" name="result" typeRef="number" />
    <informationRequirement id="IR_mc_tier">
      <requiredInput href="#InputData_tier" />
    </informationRequirement>
    <informationRequirement id="IR_mc_score">
      <requiredInput href="#InputData_score" />
    </informationRequirement>
    <decisionTable id="DT_mixed_columns" hitPolicy="FIRST">
      <input id="In_mc_tier" label="tier">
        <inputExpression typeRef="string"><text>tier</text></inputExpression>
      </input>
      <input id="In_mc_score" label="score">
        <inputExpression typeRef="number"><text>score</text></inputExpression>
      </input>
      <output id="Out_mc" label="result" name="result" typeRef="number" />
      <rule id="R_mc_1">
        <inputEntry id="IE_mc_1a"><text>"gold"</text></inputEntry>
        <inputEntry id="IE_mc_1b"><text>&gt; 80</text></inputEntry>
        <outputEntry id="OE_mc_1"><text>500</text></outputEntry>
      </rule>
      <rule id="R_mc_2">
        <inputEntry id="IE_mc_2a"><text>"gold"</text></inputEntry>
        <inputEntry id="IE_mc_2b"><text>&lt;= 80</text></inputEntry>
        <outputEntry id="OE_mc_2"><text>200</text></outputEntry>
      </rule>
      <rule id="R_mc_3">
        <inputEntry id="IE_mc_3a"><text>"silver"</text></inputEntry>
        <inputEntry id="IE_mc_3b"><text>&gt; 50</text></inputEntry>
        <outputEntry id="OE_mc_3"><text>100</text></outputEntry>
      </rule>
      <rule id="R_mc_4">
        <inputEntry id="IE_mc_4a"><text>"silver"</text></inputEntry>
        <inputEntry id="IE_mc_4b"><text>&lt;= 50</text></inputEntry>
        <outputEntry id="OE_mc_4"><text>25</text></outputEntry>
      </rule>
      <rule id="R_mc_5">
        <inputEntry id="IE_mc_5a"><text>"bronze"</text></inputEntry>
        <inputEntry id="IE_mc_5b"><text>-</text></inputEntry>
        <outputEntry id="OE_mc_5"><text>5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- Table 4: Numeric equality (integer indexed column) -->
  <decision id="Decision_numeric_index" name="Numeric Index">
    <variable id="Var_ni" name="result" typeRef="string" />
    <informationRequirement id="IR_ni_code">
      <requiredInput href="#InputData_code" />
    </informationRequirement>
    <decisionTable id="DT_numeric_index" hitPolicy="UNIQUE">
      <input id="In_ni_code" label="code">
        <inputExpression typeRef="number"><text>code</text></inputExpression>
      </input>
      <output id="Out_ni" label="result" name="result" typeRef="string" />
      <rule id="R_ni_1">
        <inputEntry id="IE_ni_1"><text>1</text></inputEntry>
        <outputEntry id="OE_ni_1"><text>"alpha"</text></outputEntry>
      </rule>
      <rule id="R_ni_2">
        <inputEntry id="IE_ni_2"><text>2</text></inputEntry>
        <outputEntry id="OE_ni_2"><text>"beta"</text></outputEntry>
      </rule>
      <rule id="R_ni_3">
        <inputEntry id="IE_ni_3"><text>3</text></inputEntry>
        <outputEntry id="OE_ni_3"><text>"gamma"</text></outputEntry>
      </rule>
      <rule id="R_ni_4">
        <inputEntry id="IE_ni_4"><text>99</text></inputEntry>
        <outputEntry id="OE_ni_4"><text>"special"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
