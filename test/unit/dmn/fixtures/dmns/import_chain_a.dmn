<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_chain_a" name="Chain Model A (root)"
  targetNamespace="https://example.com/dmn/chain-a">

  <import id="Import_b"
    namespace="https://example.com/dmn/chain-b"
    importType="https://www.omg.org/spec/DMN/20191111/MODEL/"/>

  <inputData id="InputData_x" name="x" />

  <decision id="Decision_final_chain" name="FinalChain">
    <variable id="Var_final_chain" name="FinalChain" />
    <informationRequirement id="ir_a_x">
      <requiredInput href="#InputData_x" />
    </informationRequirement>
    <informationRequirement id="ir_a_add_triple">
      <requiredDecision href="https://example.com/dmn/chain-b#Decision_add_triple" />
    </informationRequirement>
    <literalExpression id="LE_final_chain">
      <text>AddTriple + 1000</text>
    </literalExpression>
  </decision>
</definitions>
