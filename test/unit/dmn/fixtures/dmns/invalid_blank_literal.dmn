<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="definitions_invalid_blank" name="Invalid Blank Literal"
  namespace="https://example.com/dmn/invalid">

  <inputData id="InputData_value" name="value">
    <variable name="value" typeRef="number"/>
  </inputData>

  <decision id="Decision_invalid_blank" name="Invalid Blank Literal Expression">
    <informationRequirement id="ir_value">
      <requiredInput href="#InputData_value"/>
    </informationRequirement>
    <literalExpression id="literal_blank" typeRef="number">
      <text></text>
    </literalExpression>
  </decision>
</definitions>
